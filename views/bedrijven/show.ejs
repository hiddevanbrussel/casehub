<%
  const activeTab = typeof tab !== "undefined" ? tab : "details";
  const initials = function (name) {
    return String(name || "?").split(/\s+/).map(function (part) { return part[0]; }).filter(Boolean).slice(0, 2).join("").toUpperCase();
  };
%>
<div class="page-head">
  <div>
    <p class="eyebrow"><%= t('companies.eyebrow') %></p>
    <h1><%= bedrijf.handelsnaam %></h1>
  </div>
  <% if (canWrite) { %>
  <div class="actions">
    <a class="ghost" href="/bedrijven/<%= bedrijf.id %>/bewerken"><%= t('common.edit') %></a>
    <form method="post" action="/bedrijven/<%= bedrijf.id %>/verwijderen" data-confirm="<%= t('companies.confirmDelete') %>">
      <button class="danger" type="submit"><%= t('common.delete') %></button>
    </form>
  </div>
  <% } %>
</div>
<nav class="case-tabs" aria-label="<%= bedrijf.handelsnaam %>">
  <a class="<%= activeTab === 'details' ? 'is-active' : '' %>" href="/bedrijven/<%= bedrijf.id %>">
    <%- icon("building-2") %>
    <%= t('companies.eyebrow') %>
  </a>
  <a class="<%= activeTab === 'contacts' ? 'is-active' : '' %>" href="/bedrijven/<%= bedrijf.id %>?tab=contacts">
    <%- icon("user") %>
    <%= t('companies.contacts') %>
  </a>
  <a class="<%= activeTab === 'cases' ? 'is-active' : '' %>" href="/bedrijven/<%= bedrijf.id %>?tab=cases">
    <%- icon("bookmark") %>
    <%= t('companies.linkedCases') %>
  </a>
</nav>
<% if (activeTab === "contacts") { %>
<section class="panel">
  <header><h2><%= t('companies.contacts') %></h2></header>
  <% if (!personen.length) { %><p class="muted"><%= t('companies.noContacts') %></p><% } %>
  <ul class="rows">
    <% personen.forEach(function (p) { %>
      <li>
        <a href="/personen?focus=<%= p.id %>">
          <span class="who-avatar assignee-av tone-<%= (p.id || "A").charCodeAt(0) % 4 %>" aria-hidden="true"><%= initials(p.naam) %></span>
          <%= p.naam || t('persons.anonymised') %>
          <% if (p.email || p.telefoon) { %><span class="muted"> · <%= [p.email, p.telefoon].filter(Boolean).join(" · ") %></span><% } %>
        </a>
      </li>
    <% }) %>
  </ul>
</section>
<% } else if (activeTab === "cases") { %>
<section class="panel">
  <header><h2><%= t('companies.linkedCases') %></h2></header>
  <% if (!zaken.length) { %><p class="muted"><%= t('companies.noCases') %></p><% } %>
  <ul class="rows">
    <% zaken.forEach(function (z) { %>
      <li><a href="/zaken/<%= z.id %>"><span class="mono"><%= z.zaaknummer %></span> <%= z.titel %></a></li>
    <% }) %>
  </ul>
</section>
<% } else { %>
<section class="panel">
  <dl class="kv">
    <div><dt><%= t('companies.kvk') %></dt><dd class="mono"><%= bedrijf.kvk || '—' %></dd></div>
    <div><dt><%= t('companies.email') %></dt><dd><%= bedrijf.email || '—' %></dd></div>
    <div><dt><%= t('companies.phone') %></dt><dd><%= bedrijf.telefoon || '—' %></dd></div>
    <div><dt><%= t('companies.address') %></dt><dd><%= bedrijf.adres || '—' %></dd></div>
    <div><dt><%= t('companies.postcode') %></dt><dd><%= bedrijf.postcode || '—' %></dd></div>
    <div><dt><%= t('companies.place') %></dt><dd><%= bedrijf.plaats || '—' %></dd></div>
  </dl>
  <% if (bedrijf.notities) { %><p class="body-copy"><%= bedrijf.notities %></p><% } %>
</section>
<% } %>

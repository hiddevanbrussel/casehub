<%
  const generateStakeholders = (Array.isArray(locals.stakeholders) ? stakeholders : []).filter(function (item) {
    return item && item.key && item.name;
  });
  function generateStakeKind(item) {
    if (item.kind === "persoon" || item.kind === "bedrijf") return item.kind;
    return String(item.key || "").indexOf("bedrijf:") === 0 ? "bedrijf" : "persoon";
  }
  const generatePeople = generateStakeholders.filter(function (item) { return generateStakeKind(item) === "persoon"; });
  const generateCompanies = generateStakeholders.filter(function (item) { return generateStakeKind(item) === "bedrijf"; });
  const bulkPeople = generatePeople.length > 1;
  const bulkCompanies = generateCompanies.length > 1;
  const showStakePicker = bulkPeople || bulkCompanies;
  const defaultBulkKind = bulkPeople ? "persoon" : (bulkCompanies ? "bedrijf" : "");
  const stufOn = Boolean(typeof stufReady !== "undefined" && stufReady);
  const createOn = Boolean(typeof createEnabled !== "undefined" && createEnabled);
  const defaultMode = stufOn && !createOn ? "interactive" : "generate";
  const recipeList = Array.isArray(recipes) ? recipes : [];
%>
<% if (!locals.hideButtons) { %>
<% if (createOn && recipeList.length) { %>
<button class="btn<%= canGenerate ? '' : ' is-disabled' %>" type="button" data-generate-open="generate" <%= canGenerate ? '' : 'disabled' %>><%= t('cases.generateDoc') %></button>
<% } %>
<button class="<%= createOn && recipeList.length ? 'ghost' : 'btn' %><%= canGenerate ? '' : ' is-disabled' %>" type="button" data-generate-open="interactive" <%= canGenerate ? '' : 'disabled' %>><%= t('cases.generateInteractive') %></button>
<% } %>
<% if (canGenerate) { %>
<dialog class="edit-modal generate-modal" id="generate-modal">
  <form class="form modal-form" method="post" action="<%= action %>" data-generate-form>
    <div class="modal-head">
      <h1 data-generate-title><%= t('cases.pickTemplate') %></h1>
      <button type="button" class="icon-btn" data-modal-close aria-label="<%= t('common.close') %>"><%- icon("x") %></button>
    </div>
    <div class="modal-body">
      <input type="hidden" name="mode" value="<%= defaultMode %>" data-generate-mode>
      <% if (locals.fromList) { %><%- include("list-return-fields") %><% } %>
      <% if (showStakePicker) { %>
      <p class="hint" data-generate-hint="batch"><%= t("cases.generateBatchHint") %></p>
      <p class="hint" data-generate-hint="interactive" hidden><%= t("cases.generateBatchInteractive") %></p>
      <div class="tpl-picker stake-picker" data-generate-stakeholders>
        <% if (bulkPeople) { %>
        <div class="stake-picker-group">
          <p class="stake-picker-label"><%= t("nav.persons") %></p>
          <div class="tpl-picker-list">
            <% generatePeople.forEach(function (stake) { %>
            <label class="check-item">
              <input type="checkbox" name="stakeholder" value="<%= stake.key %>" data-stake-kind="persoon" <%= defaultBulkKind === "persoon" ? "checked" : "" %>>
              <span><%= stake.name %></span>
            </label>
            <% }) %>
          </div>
        </div>
        <% } %>
        <% if (bulkCompanies) { %>
        <div class="stake-picker-group">
          <p class="stake-picker-label"><%= t("nav.companies") %></p>
          <div class="tpl-picker-list">
            <% generateCompanies.forEach(function (stake) { %>
            <label class="check-item">
              <input type="checkbox" name="stakeholder" value="<%= stake.key %>" data-stake-kind="bedrijf" <%= defaultBulkKind === "bedrijf" ? "checked" : "" %>>
              <span><%= stake.name %></span>
            </label>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>
      <% if (recipeList.length) { %>
      <p class="hint"><%= t('cases.pickTemplate') %></p>
      <div class="tpl-picker" data-generate-picker>
        <% if (recipeList.length > 6) { %>
        <div class="tpl-picker-bar">
          <input type="search" data-generate-filter placeholder="<%= t('templates.search') %>" autocomplete="off">
        </div>
        <% } %>
        <div class="tpl-picker-list">
          <% recipeList.forEach(function (recipe, index) { %>
          <label class="check-item">
            <input type="radio" name="recipeId" value="<%= recipe.itemId %>" <%= index === 0 ? "checked" : "" %> <%= stufOn ? "" : "required" %>>
            <span><%= recipe.name %> <small class="tpl-type"><%= recipe.recipeType || "" %></small></span>
          </label>
          <% }) %>
        </div>
      </div>
      <% } %>
      <% if (stufOn) { %>
      <p class="hint"><%= t("stuf.templateIdHint") %></p>
      <label><%= t("stuf.templateId") %>
        <input name="stufTemplateId" <%= recipeList.length ? "" : "required" %> placeholder="1859ef9a-7331-42a0-a9b6-05547ce91452" autocomplete="off">
      </label>
      <% } %>
    </div>
    <footer class="modal-foot">
      <button type="button" class="ghost" data-modal-close><%= t('common.cancel') %></button>
      <button class="btn" type="submit" data-generate-submit><%= defaultMode === "interactive" ? t("cases.generateInteractive") : t("cases.generateDoc") %></button>
    </footer>
  </form>
</dialog>
<% } %>

<p class="back-link"><a href="/instellingen"><%= t('settings.back') %></a></p>
<div class="page-head">
  <div>
    <h1><%= t('settings.generalTitle') %></h1>
    <p class="lede"><%= t('settings.generalLede') %></p>
  </div>
</div>

<form class="form settings-form" method="post" action="/instellingen/algemeen">
  <section class="form-card">
    <h2><%= t("settings.themeSection") %></h2>
    <p class="hint"><%= t("settings.themeHint") %></p>
    <div class="chrome-picker" data-chrome-picker role="radiogroup" aria-label="<%= t("settings.themeSection") %>">
      <label class="chrome-option">
        <input class="visually-hidden" type="radio" name="chrome" value="paper" <%= locals.chrome !== "sage" ? "checked" : "" %>>
        <span class="chrome-preview is-paper" aria-hidden="true">
          <span class="chrome-preview-side"></span>
          <span class="chrome-preview-main">
            <span class="chrome-preview-bar"></span>
            <span class="chrome-preview-card"></span>
          </span>
        </span>
        <strong><%= t("settings.themePaper") %></strong>
        <small><%= t("settings.themePaperHint") %></small>
      </label>
      <label class="chrome-option">
        <input class="visually-hidden" type="radio" name="chrome" value="sage" <%= locals.chrome === "sage" ? "checked" : "" %>>
        <span class="chrome-preview is-sage" aria-hidden="true">
          <span class="chrome-preview-side"></span>
          <span class="chrome-preview-main">
            <span class="chrome-preview-bar"></span>
            <span class="chrome-preview-card"></span>
          </span>
        </span>
        <strong><%= t("settings.themeSage") %></strong>
        <small><%= t("settings.themeSageHint") %></small>
      </label>
    </div>
  </section>

  <section class="form-card">
    <h2><%= t("settings.orgSection") %></h2>
    <div class="form-grid">
      <label class="span-all"><%= t("settings.orgName") %>
        <input name="orgName" required value="<%= meta.orgName %>">
      </label>
      <label class="span-all"><%= t("settings.profile") %>
        <select name="appProfile">
          <option value="cases" <%= appProfile === "cases" ? "selected" : "" %>><%= t("onboard.profileCases") %></option>
          <option value="hr" <%= appProfile === "hr" ? "selected" : "" %>><%= t("onboard.profileHr") %></option>
          <option value="both" <%= appProfile === "both" ? "selected" : "" %>><%= t("onboard.profileBoth") %></option>
        </select>
        <span class="hint"><%= t("settings.profileHint") %></span>
      </label>
    </div>
  </section>

  <% const org = meta.org && typeof meta.org === "object" ? meta.org : {}; %>
  <section class="form-card">
    <h2><%= t("settings.companySection") %></h2>
    <p class="hint"><%= t("settings.companyHint") %></p>
    <div class="form-grid form-grid-2">
      <label class="span-all"><%= t("settings.orgLegalName") %>
        <input name="org[naam]" value="<%= org.naam || "" %>" placeholder="<%= meta.orgName %>">
        <span class="hint"><%= t("settings.orgLegalNameHint") %></span>
      </label>
      <label><%= t("companies.kvk") %>
        <input name="org[kvk]" value="<%= org.kvk || "" %>">
      </label>
      <label><%= t("settings.orgBtw") %>
        <input name="org[btw]" value="<%= org.btw || "" %>">
      </label>
      <label><%= t("companies.email") %>
        <input type="email" name="org[email]" value="<%= org.email || "" %>">
      </label>
      <label><%= t("companies.phone") %>
        <input name="org[telefoon]" value="<%= org.telefoon || "" %>">
      </label>
      <label class="span-all"><%= t("settings.orgWebsite") %>
        <input name="org[website]" value="<%= org.website || "" %>" placeholder="https://">
      </label>
      <label class="span-all"><%= t("companies.address") %>
        <input name="org[adres]" value="<%= org.adres || "" %>">
      </label>
      <label><%= t("companies.postcode") %>
        <input name="org[postcode]" value="<%= org.postcode || "" %>">
      </label>
      <label><%= t("companies.place") %>
        <input name="org[plaats]" value="<%= org.plaats || "" %>">
      </label>
      <label class="span-all"><%= t("persons.country") %>
        <input name="org[land]" value="<%= org.land || "" %>">
      </label>
    </div>
  </section>

  <section class="form-card">
    <h2><%= t("settings.numberingSection") %></h2>
    <div class="form-grid<%= isCases && isHr ? " form-grid-2" : "" %>">
      <% if (isCases) { %>
      <label><%= t("settings.prefix") %>
        <input name="zaakPrefix" required maxlength="6" value="<%= meta.zaakPrefix %>">
        <span class="hint"><%= t("settings.nextNumber") %> <span class="mono"><%= meta.zaakPrefix %>-<%= new Date().getFullYear() %>-<%= String(meta.nextZaakSeq).padStart(4, "0") %></span></span>
      </label>
      <% } else { %>
      <input type="hidden" name="zaakPrefix" value="<%= meta.zaakPrefix %>">
      <% } %>
      <% if (isHr) { %>
      <label><%= t("onboard.personeelPrefix") %>
        <input name="personeelPrefix" required maxlength="6" value="<%= meta.personeelPrefix || "P" %>">
        <span class="hint"><%= t("settings.nextStaff") %> <span class="mono"><%= meta.personeelPrefix || "P" %>-<%= String(meta.nextPersoneelSeq || 1).padStart(5, "0") %></span></span>
      </label>
      <% } else { %>
      <input type="hidden" name="personeelPrefix" value="<%= meta.personeelPrefix || "P" %>">
      <% } %>
    </div>
  </section>

  <% if (isCases) { %>
  <section class="form-card">
    <h2><%= t("settings.workflowSection") %></h2>
    <label class="set-toggle">
      <span>
        <strong><%= t("settings.quickStatus") %></strong>
        <small><%= t("settings.quickStatusHint") %></small>
      </span>
      <input type="hidden" name="quickStatusChange" value="0">
      <input type="checkbox" name="quickStatusChange" value="1" <%= meta.quickStatusChange !== false ? "checked" : "" %>>
    </label>
  </section>
  <% } %>

  <div class="form-actions">
    <button class="btn" type="submit"><%= t("settings.save") %></button>
  </div>
</form>

<% if (isCases) { %>
<section class="set-demo">
  <div>
    <h2><%= t("settings.demoTitle") %></h2>
    <p><%= t("settings.demoLede") %></p>
  </div>
  <form method="post" action="/instellingen/algemeen/demo" data-confirm="<%= t('settings.demoConfirm') %>">
    <button class="ghost" type="submit"><%= t("settings.demoImport") %></button>
  </form>
</section>
<% } %>

<%
  const tabs = [
    { id: "connection", label: t("stuf.tabConnection") },
    { id: "identity", label: t("stuf.tabIdentity") },
    { id: "certs", label: t("stuf.certsTitle") },
  ];
  const activeTab = tabs.some(function (tab) { return tab.id === stufTab; }) ? stufTab : "connection";
%>
<p class="back-link"><a href="/instellingen/integraties"><%= t("integrations.back") %></a></p>
<% if (stuf.lastError) { %><p class="alert"><%= stuf.lastError %></p><% } %>
<form class="form settings-sheet" method="post" action="/instellingen/stuf-dcr" enctype="multipart/form-data" data-form-tabs>
  <input type="hidden" name="stufTab" value="<%= activeTab %>" data-form-tab-value>
  <div class="settings-sheet-head">
    <div class="settings-sheet-title">
      <span class="catalog-tile-ico" aria-hidden="true"><%- icon("file-output") %></span>
      <div>
        <div class="settings-sheet-heading">
          <h1><%= t("stuf.title") %></h1>
          <span class="badge <%= stufReady ? "badge-afgerond" : "badge-wacht_op_info" %>"><%= stufReady ? t("common.connected") : t("common.notConfigured") %></span>
        </div>
        <p class="lede"><%= t("stuf.lede") %></p>
      </div>
    </div>
    <div class="settings-tabs" role="tablist" aria-label="<%= t("stuf.title") %>">
      <% tabs.forEach(function (tab) { %>
      <% const on = tab.id === activeTab; %>
      <button type="button" class="<%= on ? "is-active" : "" %>" role="tab" id="stuf-tab-<%= tab.id %>" aria-controls="stuf-panel-<%= tab.id %>" aria-selected="<%= on ? "true" : "false" %>" tabindex="<%= on ? "0" : "-1" %>" data-form-tab="<%= tab.id %>">
        <%= tab.label %>
      </button>
      <% }) %>
    </div>
  </div>
  <div class="settings-sheet-body">

  <section class="settings-panel" role="tabpanel" id="stuf-panel-connection" aria-labelledby="stuf-tab-connection" data-form-panel="connection"<% if (activeTab !== "connection") { %> hidden<% } %>>
    <div class="settings-note">
      <p class="hint"><%= t("stuf.howTo") %></p>
    </div>
    <label><%= t("stuf.dcaUrl") %>
      <input name="dcaUrl" class="settings-url" required value="<%= stuf.dcaUrl %>" placeholder="https://create.example.nl/stuf/dcr" autocomplete="off">
      <span class="hint"><%= t("stuf.dcaUrlHint") %></span>
    </label>
    <label><%= t("stuf.soapAction") %>
      <textarea name="soapAction" class="settings-url" rows="3" placeholder="http://www.kinggemeenten.nl/StUF/sector/dcr/0310/verzoekStartenDocumentcreatieDi02" autocomplete="off"><%= stuf.soapAction %></textarea>
    </label>
    <label><%= t("stuf.publicUrl") %>
      <input name="publicBaseUrl" class="settings-url" value="<%= stuf.publicBaseUrl %>" placeholder="https://zaakhub.example.nl" autocomplete="off">
      <span class="hint"><%= t("stuf.publicUrlHint") %></span>
    </label>
    <label><%= t("stuf.templates") %>
      <textarea name="templatesText" class="settings-url" rows="5" placeholder="1859ef9a-7331-42a0-a9b6-05547ce91452 | Welkomstbrief" autocomplete="off"><%= typeof stufTemplatesText !== "undefined" ? stufTemplatesText : "" %></textarea>
      <span class="hint"><%= t("stuf.templatesHint") %></span>
    </label>
    <div class="settings-note">
      <span class="field-caption"><%= t("stuf.callback") %></span>
      <% if (stufCallback) { %>
      <p class="hint mono"><%= stufCallback %></p>
      <p class="hint"><%= t("stuf.callbackHint") %></p>
      <% } %>
      <span class="field-caption"><%= t("stuf.lastResult") %></span>
      <% if (stuf.lastResultAt) { %>
      <p class="hint"><%= formatDateTime(stuf.lastResultAt) %></p>
      <p class="hint"><%= t("stuf.status." + (stuf.lastResultStatus || "ok")) %><% if (stuf.lastResultDetail) { %> · <%= stuf.lastResultDetail %><% } %></p>
      <% } else { %>
      <p class="hint"><%= t("stuf.lastResultNone") %></p>
      <% } %>
    </div>
  </section>

  <section class="settings-panel" role="tabpanel" id="stuf-panel-identity" aria-labelledby="stuf-tab-identity" data-form-panel="identity"<% if (activeTab !== "identity") { %> hidden<% } %>>
    <span class="field-caption"><%= t("stuf.ontvanger") %></span>
    <div class="form-row form-row-2">
      <label><%= t("stuf.ontvangerOrganisatie") %> <input name="ontvangerOrganisatie" value="<%= stuf.ontvangerOrganisatie %>" autocomplete="off"></label>
      <label><%= t("stuf.ontvangerApplicatie") %> <input name="ontvangerApplicatie" value="<%= stuf.ontvangerApplicatie %>" autocomplete="off"></label>
    </div>
    <span class="field-caption"><%= t("stuf.zender") %></span>
    <div class="form-row form-row-2">
      <label><%= t("stuf.zenderOrganisatie") %> <input name="zenderOrganisatie" value="<%= stuf.zenderOrganisatie %>" autocomplete="off"></label>
      <label><%= t("stuf.zenderApplicatie") %> <input name="zenderApplicatie" value="<%= stuf.zenderApplicatie %>" autocomplete="off"></label>
    </div>
    <div class="form-row form-row-2">
      <label><%= t("stuf.zenderAdministratie") %> <input name="zenderAdministratie" value="<%= stuf.zenderAdministratie %>" autocomplete="off"></label>
      <label><%= t("stuf.zenderGebruiker") %> <input name="zenderGebruiker" value="<%= stuf.zenderGebruiker %>" autocomplete="off"></label>
    </div>
  </section>

  <section class="settings-panel" role="tabpanel" id="stuf-panel-certs" aria-labelledby="stuf-tab-certs" data-form-panel="certs"<% if (activeTab !== "certs") { %> hidden<% } %>>
    <p class="hint"><%= t("stuf.certsHint") %></p>
    <label><%= t("stuf.inboundCert") %>
      <input type="file" name="inboundCertFile" accept=".cer,.crt,.pem,.txt">
    </label>
    <label><%= t("stuf.inboundCertPem") %>
      <textarea name="inboundCertPem" rows="6" placeholder="-----BEGIN CERTIFICATE-----" autocomplete="off"></textarea>
      <span class="hint"><%= t("stuf.inboundCertHint") %></span>
    </label>
    <% if (stuf.hasInboundCert) { %>
    <div class="settings-meta">
      <p class="hint"><%= t("stuf.inboundCertPresent") %></p>
      <% if (stuf.inboundCertMeta && stuf.inboundCertMeta.subject) { %><p class="hint mono"><%= stuf.inboundCertMeta.subject %></p><% } %>
      <% if (stuf.inboundCertMeta && stuf.inboundCertMeta.fingerprint) { %><p class="hint mono"><%= stuf.inboundCertMeta.fingerprint %></p><% } %>
    </div>
    <label class="set-toggle">
      <span><strong><%= t("stuf.clearInboundCert") %></strong></span>
      <input type="hidden" name="clearInboundCert" value="0">
      <input type="checkbox" name="clearInboundCert" value="1">
    </label>
    <% } %>
    <label><%= t("stuf.outboundCert") %>
      <input type="file" name="outboundCertFile" accept=".pfx,.p12">
    </label>
    <label><%= t("stuf.outboundPass") %>
      <input name="outboundPass" type="password" value="" placeholder="<%= stuf.hasOutboundCert ? t('stuf.keepSecret') : '' %>" autocomplete="new-password">
      <span class="hint"><%= t("stuf.outboundCertHint") %></span>
    </label>
    <% if (stuf.hasOutboundCert) { %>
    <div class="settings-meta">
      <p class="hint"><%= t("stuf.outboundCertPresent") %></p>
      <% if (stuf.outboundCertMeta && stuf.outboundCertMeta.fileName) { %><p class="hint mono"><%= stuf.outboundCertMeta.fileName %></p><% } %>
    </div>
    <label class="set-toggle">
      <span><strong><%= t("stuf.clearOutboundCert") %></strong></span>
      <input type="hidden" name="clearOutboundCert" value="0">
      <input type="checkbox" name="clearOutboundCert" value="1">
    </label>
    <% } %>
  </section>
  </div>
  <footer class="settings-sheet-foot">
    <button class="btn" type="submit"><%= t("stuf.save") %></button>
  </footer>
</form>

<div class="list-bulk" data-bulk-bar hidden data-selected-template="<%= t('cases.selectedCount', { n: '{n}' }) %>">
  <p class="list-bulk-count" aria-live="polite" data-bulk-count></p>
  <div class="list-bulk-actions">
    <button class="list-bulk-delete" type="submit" name="delete" value="1" data-bulk-delete><%= t("common.delete") %></button>
    <button class="list-bulk-clear" type="button" data-bulk-clear><%= t("cases.clearSelection") %></button>
  </div>
</div>

<p class="back-link"><a href="/instellingen/integraties"><%= t("integrations.back") %></a></p>
<% if (azure.lastError) { %><p class="alert"><%= azure.lastError %></p><% } %>
<form class="form settings-sheet" method="post" action="/instellingen/azure">
  <div class="settings-sheet-head">
    <div class="settings-sheet-title">
      <span class="catalog-tile-ico" aria-hidden="true"><%- icon("key-round") %></span>
      <div>
        <div class="settings-sheet-heading">
          <h1><%= t("azure.title") %></h1>
          <span class="badge <%= azureReady ? "badge-afgerond" : "badge-wacht_op_info" %>"><%= azureReady ? t("common.connected") : t("common.notConfigured") %></span>
        </div>
        <p class="lede"><%= t("azure.lede") %></p>
      </div>
    </div>
  </div>
  <div class="settings-sheet-body">
    <label><%= t("azure.tenantId") %>
      <input name="tenantId" class="settings-url" required value="<%= azure.tenantId %>" autocomplete="off">
    </label>
    <label><%= t("azure.clientId") %>
      <input name="clientId" class="settings-url" required value="<%= azure.clientId %>" autocomplete="off">
    </label>
    <label><%= t("azure.clientSecret") %>
      <input name="clientSecret" type="password" value="" placeholder="<%= azure.hasSecret ? "••••••••  (" + t("azure.keepSecret") + ")" : "" %>" autocomplete="new-password">
    </label>
    <label><%= t("azure.redirectUri") %>
      <input class="settings-url is-readonly" value="<%= redirectUri %>" readonly>
      <span class="hint"><%= t("azure.redirectHint") %></span>
    </label>
  </div>
  <footer class="settings-sheet-foot">
    <button class="btn" type="submit"><%= t("azure.save") %></button>
  </footer>
</form>

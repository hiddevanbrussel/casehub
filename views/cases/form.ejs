<%
  const z = zaak || {};
  const today = new Date().toISOString().slice(0, 10);
  const leadStart = (z.startdatum || z.createdAt || "").slice(0, 10) || today;
  const selectedPersonen = z.personen || [];
  const selectedBedrijven = z.bedrijven || [];
  const personOptions = (typeof personen !== "undefined" ? personen : []).map(function (p) {
    return { id: p.id, name: p.naam, meta: [p.email, p.telefoon].filter(Boolean).join(" · "), extra: p.bedrijf ? p.bedrijf.handelsnaam : "", email: p.email || "" };
  });
  const companyOptions = (typeof bedrijven !== "undefined" ? bedrijven : []).map(function (b) {
    return { id: b.id, name: b.handelsnaam, meta: [b.kvk, b.plaats].filter(Boolean).join(" · "), extra: b.email || "", email: b.email || "" };
  });
%>
<form class="form form-page" method="post" action="<%= zaak && zaak.id ? '/zaken/' + zaak.id : '/zaken' %>" data-case-form>
  <input type="hidden" name="voortgang" value="<%= z.voortgang ?? 0 %>">
  <input type="hidden" name="prioriteit" value="<%= z.prioriteit || 'normaal' %>">
  <input type="hidden" name="deadline" value="<%= z.deadline || '' %>" data-deadline>
  <div class="page-head">
    <div>
      <p class="eyebrow"><%= t('nav.cases') %></p>
      <h1><%= zaak && zaak.id ? t('cases.edit') : t('cases.new') %></h1>
    </div>
    <div class="actions">
      <a class="ghost" href="<%= zaak && zaak.id ? '/zaken/' + zaak.id : '/zaken' %>"><%= t('common.cancel') %></a>
      <button class="btn" type="submit"><%= t('common.save') %></button>
    </div>
  </div>

  <div class="form-cols">
    <section class="form-card">
      <h2>
        <%- icon("clipboard-list") %>
        <%= t('cases.tabDetails') %>
      </h2>
      <div class="form-grid">
        <label class="span-all"><%= t('cases.title') %> *
          <input name="titel" required value="<%= z.titel || '' %>">
        </label>
        <div class="form-grid form-grid-3 span-all">
          <label><%= t('cases.caseId') %>
            <input class="is-readonly" value="<%= z.zaaknummer || t('cases.caseIdSoon') %>" readonly>
          </label>
          <label><%= t('cases.reference') %>
            <input name="referentie" value="<%= z.referentie || '' %>" placeholder="PA-1233-8765">
          </label>
          <label><%= t('cases.type') %>
            <select name="zaaktypeId">
              <option value="" data-lead="0">—</option>
              <% (typeof zaaktypen !== "undefined" ? zaaktypen : []).forEach(function (type) { %>
                <option value="<%= type.id %>" data-lead="<%= type.leadTimeDays || 0 %>" <%= z.zaaktypeId === type.id ? "selected" : "" %>><%= type.naam %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <label class="span-all"><%= t('cases.description') %>
          <textarea name="omschrijving" rows="6"><%= z.omschrijving || '' %></textarea>
        </label>
        <div class="form-grid form-grid-2 span-all">
          <label><%= t('cases.status') %>
            <select name="status">
              <% statussen.forEach(function (s) { %>
                <option value="<%= s.id %>" <%= (z.status || 'nieuw') === s.id ? 'selected' : '' %>><%= t('status.' + s.id) %></option>
              <% }) %>
            </select>
          </label>
          <label><%= t('cases.caseManager') %>
            <select name="behandelaarId">
              <option value="">—</option>
              <% werknemers.forEach(function (w) { %>
                <option value="<%= w.id %>" <%= z.behandelaarId === w.id ? 'selected' : '' %>><%= w.naam %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <div class="form-grid form-grid-2 span-all">
          <label>
            <%= t('cases.startDate') %>
            <input type="date" name="startdatum" value="<%= leadStart %>" data-lead-start>
          </label>
          <label>
            <%= t('cases.endDate') %>
            <input type="date" class="is-readonly" value="<%= (z.deadline || '').slice(0, 10) %>" data-planned-end readonly tabindex="-1">
          </label>
          <p class="hint span-all"><%= t('cases.leadHint') %></p>
        </div>
      </div>
    </section>

    <section class="form-card" data-stakeholder-picker>
      <h2>
        <%- icon("user") %>
        <%= t('cases.stakeholders') %>
      </h2>
      <p class="hint"><%= t('cases.stakeholderHint') %></p>
      <div class="holders" data-stake-list>
        <% selectedPersonen.forEach(function (p) { %>
          <details class="holder" data-kind="person" data-id="<%= p.id %>">
            <summary>
              <%- icon("chevron-down") %>
              <%= p.naam %>
            </summary>
            <div class="holder-body">
              <% if (p.email || p.telefoon) { %><p><%= [p.email, p.telefoon].filter(Boolean).join(" · ") %></p><% } %>
              <button type="button" class="linkish danger-text" data-stake-remove><%= t('common.delete') %></button>
            </div>
          </details>
          <input type="hidden" name="persoonIds" value="<%= p.id %>">
        <% }) %>
        <% selectedBedrijven.forEach(function (b) { %>
          <details class="holder" data-kind="company" data-id="<%= b.id %>">
            <summary>
              <%- icon("chevron-down") %>
              <%= b.handelsnaam %>
            </summary>
            <div class="holder-body">
              <% if (b.kvk || b.plaats) { %><p><%= [b.kvk, b.plaats].filter(Boolean).join(" · ") %></p><% } %>
              <button type="button" class="linkish danger-text" data-stake-remove><%= t('common.delete') %></button>
            </div>
          </details>
          <input type="hidden" name="bedrijfIds" value="<%= b.id %>">
        <% }) %>
      </div>
      <div class="stake-add">
        <label class="stake-search">
          <span class="visually-hidden"><%= t('cases.searchStakeholder') %></span>
          <%- icon("search") %>
          <input type="search" data-stake-q placeholder="<%= t('cases.searchStakeholder') %>" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list">
        </label>
        <div class="stake-results" data-stake-results hidden role="listbox"></div>
      </div>
      <script type="application/json" data-stake-json><%- JSON.stringify({ persons: personOptions, companies: companyOptions }).replace(/</g, "\\u003c") %></script>
    </section>
  </div>
</form>

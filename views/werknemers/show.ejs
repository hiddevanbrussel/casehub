<%
  const canGenerate = Boolean(createReady && recipes.length);
  const detailsTab = tab !== "documents";
  const aanhefLabel = werknemer.aanhef === "heer" ? t("hr.heer") : (werknemer.aanhef === "mevrouw" ? t("hr.mevrouw") : (werknemer.aanhef || "—"));
  const v = function (value) { return value || "—"; };
%>
<div class="case-page">
  <div class="case-top">
    <div class="case-title">
      <a class="case-back" href="/werknemers" aria-label="<%= t('common.back') %>">
        <%- icon("chevron-left") %>
      </a>
      <div>
        <h1><%= werknemer.naam %></h1>
        <p class="lede"><%= t('hr.staffNo') %>: <%= v(werknemer.personeelsnummer) %></p>
      </div>
    </div>
    <div class="actions">
      <% if (canWrite) { %>
      <%- include("../partials/generate-doc", { action: "/werknemers/" + werknemer.id + "/documenten", recipes: recipes, canGenerate: canGenerate }) %>
      <a class="ghost" href="/werknemers/<%= werknemer.id %>/bewerken">
        <%- icon("pencil") %>
        <%= t('common.edit') %>
      </a>
      <details class="menu-dots">
        <summary class="ghost icon-more" aria-label="<%= t('cases.more') %>"><%- icon("ellipsis") %></summary>
        <div class="menu-dots-list">
          <form method="post" action="/werknemers/<%= werknemer.id %>/verwijderen" data-confirm="<%= t('employees.confirmDelete') %>">
            <button class="danger-text" type="submit"><%= t('common.delete') %></button>
          </form>
        </div>
      </details>
      <% } %>
    </div>
  </div>

  <nav class="case-tabs">
    <a class="<%= detailsTab ? 'is-active' : '' %>" href="/werknemers/<%= werknemer.id %>">
      <%- icon("user") %>
      <%= t('hr.tabContact') %>
    </a>
    <a class="<%= detailsTab ? '' : 'is-active' %>" href="/werknemers/<%= werknemer.id %>?tab=documents">
      <%- icon("file-text") %>
      <%= t('cases.tabDocuments') %>
    </a>
  </nav>

  <section class="meta-bar">
    <div>
      <span><%= t('hr.staffNo') %></span>
      <strong class="mono"><%= v(werknemer.personeelsnummer) %></strong>
    </div>
    <% if (isHr) { %>
    <div>
      <span><%= t('hr.job') %></span>
      <strong><%= v(werknemer.functiebenaming) %></strong>
    </div>
    <div>
      <span><%= t('hr.location') %></span>
      <strong><%= v(werknemer.vestiging) %></strong>
    </div>
    <div>
      <span><%= t('hr.startDate') %></span>
      <strong><%= formatDate(werknemer.datumIndiensttreding) %></strong>
    </div>
    <% } else { %>
    <div>
      <span><%= t('employees.role') %></span>
      <strong><%= t('role.' + werknemer.rol) %></strong>
    </div>
    <div>
      <span><%= t('employees.department') %></span>
      <strong><%= v(werknemer.afdeling) %></strong>
    </div>
    <% } %>
    <div>
      <span><%= t('hr.updated') %></span>
      <strong><%= formatDateTime(werknemer.updatedAt) %></strong>
    </div>
  </section>

  <% if (detailsTab) { %>
  <div class="case-cols">
    <div>
      <section class="case-card">
        <h2>
          <%- icon("user") %>
          <%= t('hr.contact') %>
        </h2>
        <div class="detail-grid">
          <% if (isHr) { %>
          <div>
            <span><%= t('hr.salutation') %></span>
            <strong><%= aanhefLabel %></strong>
          </div>
          <% } %>
          <div>
            <span><%= t('employees.firstName') %></span>
            <strong><%= v(werknemer.voornaam) %></strong>
          </div>
          <div>
            <span><%= t('employees.lastName') %></span>
            <strong><%= v(werknemer.achternaam) %></strong>
          </div>
          <% if (isHr) { %>
          <div>
            <span><%= t('hr.dob') %></span>
            <strong><%= formatDate(werknemer.geboortedatum) %></strong>
          </div>
          <% } else { %>
          <div>
            <span><%= t('employees.email') %></span>
            <strong><%= v(werknemer.email) %></strong>
          </div>
          <% } %>
        </div>
      </section>

      <% if (isHr) { %>
      <section class="case-card">
        <h2>
          <%- icon("briefcase") %>
          <%= t('hr.employment') %>
        </h2>
        <div class="detail-grid">
          <div>
            <span><%= t('hr.startDate') %></span>
            <strong><%= formatDate(werknemer.datumIndiensttreding) %></strong>
          </div>
          <div>
            <span><%= t('hr.job') %></span>
            <strong><%= v(werknemer.functiebenaming) %></strong>
          </div>
          <div>
            <span><%= t('hr.scale') %></span>
            <strong><%= v(werknemer.inschaling) %></strong>
          </div>
          <div>
            <span><%= t('hr.salary') %></span>
            <strong><%= v(werknemer.salaris) %></strong>
          </div>
          <div>
            <span><%= t('hr.companyCar') %></span>
            <strong><%= werknemer.leaseauto ? t('hr.yes') : t('hr.no') %></strong>
          </div>
          <div>
            <span><%= t('hr.location') %></span>
            <strong><%= v(werknemer.vestiging) %></strong>
          </div>
        </div>
      </section>
      <% } %>
    </div>

    <div>
      <% if (isHr) { %>
      <section class="case-card">
        <h2>
          <%- icon("house") %>
          <%= t('hr.address') %>
        </h2>
        <div class="detail-grid">
          <div>
            <span><%= t('hr.street') %></span>
            <strong><%= v(werknemer.straat) %></strong>
          </div>
          <div>
            <span><%= t('hr.houseNo') %></span>
            <strong><%= v(werknemer.huisnummer) %></strong>
          </div>
          <div>
            <span><%= t('hr.postcode') %></span>
            <strong><%= v(werknemer.postcode) %></strong>
          </div>
          <div>
            <span><%= t('hr.city') %></span>
            <strong><%= v(werknemer.plaats) %></strong>
          </div>
        </div>
      </section>
      <% } %>

      <% if (isCases) { %>
      <section class="case-card">
        <h2>
          <%- icon("bookmark") %>
          <%= t('employees.assignedCases') %>
        </h2>
        <% if (!zaken.length) { %><p class="muted"><%= t('employees.noCases') %></p><% } %>
        <ul class="rows">
          <% zaken.forEach(function (z) { %>
            <li><a href="/zaken/<%= z.id %>"><span class="mono"><%= z.zaaknummer %></span> <%= z.titel %></a></li>
          <% }) %>
        </ul>
      </section>
      <% } %>
    </div>
  </div>
  <% } else { %>
  <section class="case-card">
    <h2>
      <%- icon("file-text") %>
      <%= t('cases.tabDocuments') %>
    </h2>
    <%
      const linkedBijlageIds = {};
      (werknemer.documentJobs || []).forEach(function (job) {
        if (job.bijlageId) linkedBijlageIds[job.bijlageId] = true;
      });
      const docRows = [];
      (werknemer.documentJobs || []).forEach(function (job) {
        const file = job.bijlageId ? werknemer.bijlagen.find(function (b) { return b.id === job.bijlageId; }) : null;
        const done = Boolean(file) || job.status === "success";
        docRows.push({
          name: file ? file.naam : job.recipeName,
          fileHref: file ? "/werknemers/" + werknemer.id + "/bijlagen/" + file.id : "",
          isPdf: file ? /pdf/i.test(file.mime || "") || /\.pdf$/i.test(file.naam || "") : false,
          createUrl: done ? "" : (job.finalizeUrl || ""),
          status: done ? "success" : job.status,
          error: job.error || "",
          deleteHref: file
            ? "/werknemers/" + werknemer.id + "/bijlagen/" + file.id + "/verwijderen"
            : "/werknemers/" + werknemer.id + "/documenten/" + job.id + "/verwijderen",
        });
      });
      (werknemer.bijlagen || []).forEach(function (b) {
        if (linkedBijlageIds[b.id]) return;
        docRows.push({
          name: b.naam,
          fileHref: "/werknemers/" + werknemer.id + "/bijlagen/" + b.id,
          isPdf: /pdf/i.test(b.mime || "") || /\.pdf$/i.test(b.naam || ""),
          createUrl: "",
          status: "uploaded",
          error: "",
          deleteHref: "/werknemers/" + werknemer.id + "/bijlagen/" + b.id + "/verwijderen",
        });
      });
      function docStatusLabel(code) {
        if (code === "uploaded") return t("cases.docUploaded");
        if (code === "success") return t("cases.docCompleted");
        if (code === "error") return t("cases.docFailed");
        if (code === "generating") return t("cases.docGenerating");
        return t("cases.docInCreate");
      }
      function docStatusBadge(code) {
        if (code === "uploaded" || code === "success") return "afgerond";
        if (code === "error") return "wacht_op_info";
        return "nieuw";
      }
    %>
    <% if (!docRows.length) { %>
      <p class="muted"><%= t('cases.noAttachments') %></p>
    <% } else { %>
    <table class="doc-table">
      <thead>
        <tr>
          <th><%= t('cases.name') %></th>
          <th><%= t('cases.openCreate') %></th>
          <th><%= t('cases.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% docRows.forEach(function (row) { %>
        <tr>
          <td>
            <% if (row.fileHref) { %>
              <a href="<%= row.fileHref %>"<% if (row.isPdf) { %> data-pdf-preview data-pdf-name="<%= row.name %>"<% } %>><%= row.name %></a>
            <% } else { %>
              <strong><%= row.name %></strong>
            <% } %>
          </td>
          <td>
            <% if (row.createUrl) { %>
              <a href="<%= row.createUrl %>" rel="noopener"><%= t('cases.openCreate') %></a>
            <% } else { %>
              <span class="muted">—</span>
            <% } %>
          </td>
          <td>
            <span class="badge badge-<%= docStatusBadge(row.status) %>"><%= docStatusLabel(row.status) %></span>
            <% if (row.error) { %><small class="muted"> <%= row.error %></small><% } %>
          </td>
          <td>
            <% if (canWrite) { %>
            <form method="post" action="<%= row.deleteHref %>" data-confirm="<%= t('cases.confirmDeleteDoc') %>">
              <button class="linkish danger-text" type="submit"><%= t('common.delete') %></button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>
  <% } %>
</div>

<%
  function pagerItems(current, totalPages) {
    if (totalPages <= 7) {
      return Array.from({ length: totalPages }, function (_, i) { return i + 1; });
    }
    const items = [1];
    const start = Math.max(2, current - 1);
    const end = Math.min(totalPages - 1, current + 1);
    if (start > 2) items.push("…");
    for (let i = start; i <= end; i += 1) items.push(i);
    if (end < totalPages - 1) items.push("…");
    items.push(totalPages);
    return items;
  }
  const pagerKeep = locals.keep || {};
%>
<footer class="list-pager">
  <span><%= rangeLabel %></span>
  <nav class="pager-pages" aria-label="<%= navLabel %>">
    <a class="pager-nav <%= page <= 1 ? 'is-disabled' : '' %>" href="<%= page <= 1 ? '#' : pageHref(page - 1) %>" aria-label="‹">‹</a>
    <% pagerItems(page, pages).forEach(function (item) { %>
      <% if (item === "…") { %>
        <span class="pager-gap">…</span>
      <% } else { %>
        <a class="<%= item === page ? 'is-active' : '' %>" href="<%= pageHref(item) %>"><%= item %></a>
      <% } %>
    <% }) %>
    <a class="pager-nav <%= page >= pages ? 'is-disabled' : '' %>" href="<%= page >= pages ? '#' : pageHref(page + 1) %>" aria-label="›">›</a>
  </nav>
  <form method="get" action="<%= action %>" class="pager-size">
    <% Object.keys(pagerKeep).forEach(function (key) { %>
      <% if (pagerKeep[key]) { %><input type="hidden" name="<%= key %>" value="<%= pagerKeep[key] %>"><% } %>
    <% }) %>
    <select name="pageSize" data-auto-submit>
      <% pageSizeOpts.forEach(function (n) { %>
        <option value="<%= n %>" <%= Number(pageSize) === n ? "selected" : "" %>><%= t("cases.perPage", { n: n }) %></option>
      <% }) %>
    </select>
  </form>
</footer>

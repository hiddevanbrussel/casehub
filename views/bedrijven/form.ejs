<% const b = bedrijf || {} %>
<form class="form form-page" method="post" action="<%= bedrijf && bedrijf.id ? '/bedrijven/' + bedrijf.id : '/bedrijven' %>">
  <div class="page-head">
    <div>
      <p class="eyebrow"><%= t('companies.eyebrow') %></p>
      <h1><%= bedrijf && bedrijf.id ? t('companies.edit') : t('companies.new') %></h1>
    </div>
    <div class="actions">
      <a class="ghost" href="<%= bedrijf && bedrijf.id ? '/bedrijven/' + bedrijf.id : '/bedrijven' %>"><%= t('common.cancel') %></a>
      <button class="btn" type="submit"><%= t('common.save') %></button>
    </div>
  </div>
  <% if (typeof error !== 'undefined' && error) { %><p class="alert"><%= error %></p><% } %>
  <div class="form-cols">
    <section class="form-card">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/>
          <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
          <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/>
          <path d="M10 6h4"/>
          <path d="M10 10h4"/>
          <path d="M10 14h4"/>
          <path d="M10 18h4"/>
        </svg>
        <%= t('companies.eyebrow') %>
      </h2>
      <div class="form-grid">
        <label class="span-all"><%= t('companies.name') %> * <input name="handelsnaam" required value="<%= b.handelsnaam || '' %>"></label>
        <label><%= t('companies.kvk') %> <input name="kvk" value="<%= b.kvk || '' %>"></label>
        <label><%= t('companies.email') %> <input type="email" name="email" value="<%= b.email || '' %>"></label>
        <label class="span-all"><%= t('companies.phone') %> <input name="telefoon" value="<%= b.telefoon || '' %>"></label>
      </div>
    </section>
    <section class="form-card">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <%= t('companies.address') %>
      </h2>
      <div class="form-grid">
        <label class="span-all"><%= t('companies.address') %> <input name="adres" value="<%= b.adres || '' %>"></label>
        <div class="form-grid form-grid-2 span-all">
          <label><%= t('companies.postcode') %> <input name="postcode" value="<%= b.postcode || '' %>"></label>
          <label><%= t('companies.place') %> <input name="plaats" value="<%= b.plaats || '' %>"></label>
        </div>
        <label class="span-all"><%= t('companies.notes') %> <textarea name="notities" rows="5"><%= b.notities || '' %></textarea></label>
      </div>
    </section>
  </div>
</form>

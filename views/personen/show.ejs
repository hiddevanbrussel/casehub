<%
  const detailsTab = tab !== "cases";
  const v = function (value) { return value || "—"; };
  const genderLabel = persoon.geslacht === "man" ? t("persons.male") : (persoon.geslacht === "vrouw" ? t("persons.female") : (persoon.geslacht === "overig" ? t("persons.other") : "—"));
%>
<div class="case-page">
  <div class="case-top">
    <div class="case-title">
      <a class="case-back" href="/personen" aria-label="<%= t('common.back') %>">
        <%- icon("chevron-left") %>
      </a>
      <h1><%= persoon.naam || t('persons.anonymised') %></h1>
    </div>
    <% if (canWrite) { %>
    <div class="actions">
      <% if (!persoon.anoniem) { %>
      <a class="ghost" href="/personen/<%= persoon.id %>/bewerken">
        <%- icon("pencil") %>
        <%= t('common.edit') %>
      </a>
      <% } %>
      <details class="menu-dots">
        <summary class="ghost icon-more" aria-label="<%= t('cases.more') %>"><%- icon("ellipsis") %></summary>
        <div class="menu-dots-list">
          <% if (!persoon.anoniem) { %>
          <form method="post" action="/personen/<%= persoon.id %>/anonimiseren" data-confirm="<%= t('persons.confirmAnon') %>">
            <button type="submit"><%= t('persons.anonymise') %></button>
          </form>
          <% } %>
          <% if (typeof isAdmin !== "undefined" && isAdmin && !persoon.anoniem) { %>
            <a href="/personen/<%= persoon.id %><%= showBsn ? '' : '?bsn=1' %>"><%= showBsn ? t('persons.hide') : t('persons.show') %> <%= t('persons.bsn') %></a>
          <% } %>
          <% if (typeof isAdmin !== "undefined" && isAdmin) { %>
          <form method="post" action="/personen/<%= persoon.id %>/verwijderen" data-confirm="<%= t('persons.confirmDelete') %>">
            <button class="danger-text" type="submit"><%= t('common.delete') %></button>
          </form>
          <% } %>
        </div>
      </details>
    </div>
    <% } %>
  </div>

  <nav class="case-tabs">
    <a class="<%= detailsTab ? 'is-active' : '' %>" href="/personen/<%= persoon.id %>">
      <%- icon("user") %>
      <%= t('hr.tabContact') %>
    </a>
    <a class="<%= detailsTab ? '' : 'is-active' %>" href="/personen/<%= persoon.id %>?tab=cases">
      <%- icon("bookmark") %>
      <%= t('persons.linkedCases') %>
    </a>
  </nav>

  <section class="meta-bar meta-bar-5">
    <div>
      <span><%= t('persons.email') %></span>
      <strong><% if (persoon.email) { %><a href="mailto:<%= persoon.email %>"><%= persoon.email %></a><% } else { %>—<% } %></strong>
    </div>
    <div>
      <span><%= t('persons.phone') %></span>
      <strong><% if (persoon.telefoon) { %><a href="tel:<%= persoon.telefoon %>"><%= persoon.telefoon %></a><% } else { %>—<% } %></strong>
    </div>
    <div>
      <span><%= t('persons.linkedCases') %></span>
      <strong><a href="/personen/<%= persoon.id %>?tab=cases"><%= zaken.length %></a></strong>
    </div>
    <div>
      <span><%= t('cases.created') %></span>
      <strong><%= formatDateTime(persoon.createdAt) %></strong>
    </div>
    <div>
      <span><%= t('cases.updated') %></span>
      <strong><%= formatDateTime(persoon.updatedAt) %></strong>
    </div>
  </section>

  <% if (detailsTab) { %>
  <div class="case-cols">
    <section class="case-card">
      <h2>
        <%- icon("user") %>
        <%= t('hr.contact') %>
      </h2>
      <div class="pair-grid">
        <div>
          <span><%= t('persons.firstName') %></span>
          <strong><%= v(persoon.voornaam) %></strong>
        </div>
        <div>
          <span><%= t('persons.infix') %></span>
          <strong><%= v(persoon.tussenvoegsel) %></strong>
        </div>
        <div>
          <span><%= t('persons.lastName') %></span>
          <strong><%= v(persoon.achternaam) %></strong>
        </div>
      </div>
      <div class="pair-grid pair-split">
        <div>
          <span><%= t('persons.email') %></span>
          <strong><% if (persoon.email) { %><a href="mailto:<%= persoon.email %>"><%= persoon.email %></a><% } else { %>—<% } %></strong>
        </div>
        <div>
          <span><%= t('persons.phone') %></span>
          <strong><% if (persoon.telefoon) { %><a href="tel:<%= persoon.telefoon %>"><%= persoon.telefoon %></a><% } else { %>—<% } %></strong>
        </div>
        <div>
          <span><%= t('persons.gender') %></span>
          <strong><%= genderLabel %></strong>
        </div>
      </div>
      <% if (showBsn || persoon.bedrijf) { %>
      <div class="pair-grid pair-split">
        <% if (showBsn) { %>
        <div>
          <span><%= t('persons.bsn') %></span>
          <strong class="mono"><%= persoon.bsn || persoon.bsnMasked %></strong>
        </div>
        <% } %>
        <% if (persoon.bedrijf) { %>
        <div>
          <span><%= t('persons.company') %></span>
          <strong><a href="/bedrijven/<%= persoon.bedrijf.id %>"><%= persoon.bedrijf.handelsnaam %></a></strong>
        </div>
        <% } %>
      </div>
      <% } %>
    </section>

    <section class="case-card">
      <h2>
        <%- icon("map-pin") %>
        <%= t('persons.address') %>
      </h2>
      <div class="pair-rows">
        <div>
          <span><%= t('persons.street') %></span>
          <strong><%= v(persoon.straat) %></strong>
        </div>
        <div>
          <span><%= t('persons.houseNo') %></span>
          <strong><%= v(persoon.huisnummer) %></strong>
        </div>
        <div>
          <span><%= t('persons.postcode') %></span>
          <strong><%= v(persoon.postcode) %></strong>
        </div>
        <div>
          <span><%= t('persons.place') %></span>
          <strong><%= v(persoon.plaats) %></strong>
        </div>
        <div>
          <span><%= t('persons.country') %></span>
          <strong><%= v(persoon.land) %></strong>
        </div>
      </div>
    </section>
  </div>
  <% } else { %>
  <section class="case-card">
    <h2>
      <%- icon("bookmark") %>
      <%= t('persons.linkedCases') %>
    </h2>
    <% if (!zaken.length) { %><p class="muted"><%= t('persons.noCases') %></p><% } %>
    <ul class="rows">
      <% zaken.forEach(function (z) { %>
        <li><a href="/zaken/<%= z.id %>"><span class="mono"><%= z.zaaknummer %></span> <%= z.titel %></a></li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</div>

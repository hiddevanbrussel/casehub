<div class="page-head overview-head">
  <div>
    <h1><%= heading %></h1>
    <button class="filter-btn" type="button" data-filter-toggle><%= t('common.addFilter') %></button>
  </div>
  <div class="actions overview-actions">
    <% if (typeof showNew === "undefined" || showNew) { %>
      <a class="btn" href="<%= newHref %>"><%= newLabel %></a>
    <% } %>
    <div class="view-switch">
      <a class="<%= view === 'overview' ? 'is-active' : '' %>" href="<%= base %>" title="<%= t('common.grouped') %>">
        <%- icon("list") %>
      </a>
      <a class="<%= view === 'table' ? 'is-active' : '' %>" href="<%= base %>?view=table" title="<%= t('common.tableView') %>">
        <%- icon("table-2") %>
      </a>
      <a class="<%= view === 'board' ? 'is-active' : '' %>" href="<%= base %>?view=board" title="<%= t('common.boardView') %>">
        <%- icon("square-kanban") %>
      </a>
    </div>
  </div>
</div>

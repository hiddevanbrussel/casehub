<%
  const canGenerate = Boolean(createReady && recipes.length);
  const tabId = tab === "documents" || tab === "cases" ? tab : "details";
  const aanhefLabel = werknemer.aanhef === "heer" ? t("hr.heer") : (werknemer.aanhef === "mevrouw" ? t("hr.mevrouw") : (werknemer.aanhef || "—"));
  const v = function (value) { return value || "—"; };
%>
<div class="case-page">
  <div class="case-top">
    <div class="case-title">
      <a class="case-back" href="/werknemers" aria-label="<%= t('common.back') %>">
        <%- icon("chevron-left") %>
      </a>
      <div>
        <h1><%= werknemer.naam %></h1>
        <p class="lede"><%= t('hr.staffNo') %>: <%= v(werknemer.personeelsnummer) %></p>
      </div>
    </div>
    <div class="actions">
      <% if (canWrite) { %>
      <%- include("../partials/generate-doc", { action: "/werknemers/" + werknemer.id + "/documenten", recipes: recipes, canGenerate: canGenerate }) %>
      <a class="ghost" href="/werknemers/<%= werknemer.id %>/bewerken">
        <%- icon("pencil") %>
        <%= t('common.edit') %>
      </a>
      <details class="menu-dots">
        <summary class="ghost icon-more" aria-label="<%= t('cases.more') %>"><%- icon("ellipsis") %></summary>
        <div class="menu-dots-list">
          <form method="post" action="/werknemers/<%= werknemer.id %>/verwijderen" data-confirm="<%= t('employees.confirmDelete') %>">
            <button class="danger-text" type="submit"><%= t('common.delete') %></button>
          </form>
        </div>
      </details>
      <% } %>
    </div>
  </div>

  <nav class="case-tabs">
    <a class="<%= tabId === 'details' ? 'is-active' : '' %>" href="/werknemers/<%= werknemer.id %>">
      <%- icon("user") %>
      <%= t('hr.tabContact') %>
    </a>
    <% if (isCases) { %>
    <a class="<%= tabId === 'cases' ? 'is-active' : '' %>" href="/werknemers/<%= werknemer.id %>?tab=cases">
      <%- icon("bookmark") %>
      <%= t('employees.assignedCases') %><% if (zaken.length) { %> (<%= zaken.length %>)<% } %>
    </a>
    <% } %>
    <a class="<%= tabId === 'documents' ? 'is-active' : '' %>" href="/werknemers/<%= werknemer.id %>?tab=documents">
      <%- icon("file-text") %>
      <%= t('cases.tabDocuments') %>
    </a>
  </nav>

  <section class="meta-bar">
    <div>
      <span><%= t('hr.staffNo') %></span>
      <strong class="mono"><%= v(werknemer.personeelsnummer) %></strong>
    </div>
    <% if (isHr) { %>
    <div>
      <span><%= t('hr.job') %></span>
      <strong><%= v(werknemer.functiebenaming) %></strong>
    </div>
    <div>
      <span><%= t('hr.location') %></span>
      <strong><%= v(werknemer.vestiging) %></strong>
    </div>
    <div>
      <span><%= t('hr.startDate') %></span>
      <strong><%= formatDate(werknemer.datumIndiensttreding) %></strong>
    </div>
    <% } else { %>
    <div>
      <span><%= t('employees.role') %></span>
      <strong><%= t('role.' + werknemer.rol) %></strong>
    </div>
    <div>
      <span><%= t('employees.department') %></span>
      <strong><%= v(werknemer.afdeling) %></strong>
    </div>
    <% } %>
    <% if (isCases) { %>
    <div>
      <span><%= t('employees.assignedCases') %></span>
      <strong><a href="/werknemers/<%= werknemer.id %>?tab=cases"><%= zaken.length %></a></strong>
    </div>
    <% } %>
    <div>
      <span><%= t('hr.updated') %></span>
      <strong><%= formatDateTime(werknemer.updatedAt) %></strong>
    </div>
  </section>

  <% if (tabId === "details") { %>
  <div class="<%= isHr ? 'case-cols' : '' %>">
    <div>
      <section class="case-card">
        <h2>
          <%- icon("user") %>
          <%= t('hr.contact') %>
        </h2>
        <div class="detail-grid">
          <% if (isHr) { %>
          <div>
            <span><%= t('hr.salutation') %></span>
            <strong><%= aanhefLabel %></strong>
          </div>
          <% } %>
          <div>
            <span><%= t('employees.firstName') %></span>
            <strong><%= v(werknemer.voornaam) %></strong>
          </div>
          <div>
            <span><%= t('employees.lastName') %></span>
            <strong><%= v(werknemer.achternaam) %></strong>
          </div>
          <% if (isHr) { %>
          <div>
            <span><%= t('hr.dob') %></span>
            <strong><%= formatDate(werknemer.geboortedatum) %></strong>
          </div>
          <% } else { %>
          <div>
            <span><%= t('employees.email') %></span>
            <strong><%= v(werknemer.email) %></strong>
          </div>
          <% } %>
        </div>
      </section>

      <% if (isHr) { %>
      <section class="case-card">
        <h2>
          <%- icon("briefcase") %>
          <%= t('hr.employment') %>
        </h2>
        <div class="detail-grid">
          <div>
            <span><%= t('hr.startDate') %></span>
            <strong><%= formatDate(werknemer.datumIndiensttreding) %></strong>
          </div>
          <div>
            <span><%= t('hr.job') %></span>
            <strong><%= v(werknemer.functiebenaming) %></strong>
          </div>
          <div>
            <span><%= t('hr.scale') %></span>
            <strong><%= v(werknemer.inschaling) %></strong>
          </div>
          <div>
            <span><%= t('hr.salary') %></span>
            <strong><%= v(werknemer.salaris) %></strong>
          </div>
          <div>
            <span><%= t('hr.companyCar') %></span>
            <strong><%= werknemer.leaseauto ? t('hr.yes') : t('hr.no') %></strong>
          </div>
          <div>
            <span><%= t('hr.location') %></span>
            <strong><%= v(werknemer.vestiging) %></strong>
          </div>
        </div>
      </section>
      <% } %>
    </div>

    <div>
      <% if (isHr) { %>
      <section class="case-card">
        <h2>
          <%- icon("house") %>
          <%= t('hr.address') %>
        </h2>
        <div class="detail-grid">
          <div>
            <span><%= t('hr.street') %></span>
            <strong><%= v(werknemer.straat) %></strong>
          </div>
          <div>
            <span><%= t('hr.houseNo') %></span>
            <strong><%= v(werknemer.huisnummer) %></strong>
          </div>
          <div>
            <span><%= t('hr.postcode') %></span>
            <strong><%= v(werknemer.postcode) %></strong>
          </div>
          <div>
            <span><%= t('hr.city') %></span>
            <strong><%= v(werknemer.plaats) %></strong>
          </div>
        </div>
      </section>
      <% } %>
    </div>
  </div>
  <% } else if (tabId === "cases") { %>
  <section class="case-card">
    <header class="case-panel-head">
      <h2>
        <%- icon("bookmark") %>
        <%= t('employees.assignedCases') %>
      </h2>
    </header>
    <%- include("../partials/case-list", {
      caseRows: zaken,
      emptyTitle: t("employees.noCases"),
    }) %>
  </section>
  <% } else { %>
  <section class="case-card">
    <header class="case-panel-head">
      <h2>
        <%- icon("file-text") %>
        <%= t('cases.tabDocuments') %>
      </h2>
      <% if (canWrite) { %>
      <button type="button" class="linkish" data-generate-open="generate" <%= canGenerate ? "" : "disabled" %>><%= t("cases.addDocument") %></button>
      <% } %>
    </header>
    <%- include("../partials/doc-list", {
      docRows: documentRows(werknemer, { basePath: "/werknemers/" + werknemer.id }),
      canDelete: Boolean(typeof canWrite !== "undefined" && canWrite),
      emptyTitle: t("hr.docEmpty"),
      emptyHint: canGenerate ? t("hr.docEmptyHint") : t("cases.generateNeedsIntegration"),
    }) %>
  </section>
  <% } %>
</div>

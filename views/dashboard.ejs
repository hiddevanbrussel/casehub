<%
  const segments = [
    { key: "nieuw", cls: "open", n: counts.byStatus.nieuw },
    { key: "wacht_op_info", cls: "wait", n: counts.byStatus.wacht_op_info },
    { key: "in_behandeling", cls: "progress", n: counts.byStatus.in_behandeling },
    { key: "afgerond", cls: "closed", n: counts.byStatus.afgerond },
  ];
%>
<div class="page-head">
  <div>
    <h1><%= t('dash.title') %></h1>
    <p class="lede"><%= t('dash.lede') %></p>
  </div>
  <div class="actions">
    <a class="btn" href="/zaken/nieuw"><%= t('nav.newCase') %></a>
    <a class="seg" href="/zaken">
      <svg viewBox="0 0 24 24"><path d="M5 6h14v2H5zm0 5h14v2H5zm0 5h14v2H5z"/></svg>
      <%= t('nav.cases') %>
    </a>
    <a class="seg" href="/zaken?view=board">
      <svg viewBox="0 0 24 24"><path d="M4 5h6v14H4zm8 0h8v8h-8zm0 10h8v4h-8z"/></svg>
      <%= t('dash.board') %>
    </a>
  </div>
</div>

<section class="stats">
  <article class="stat">
    <span class="stat-ico ico-total"><svg viewBox="0 0 24 24"><path d="M7 4h10a2 2 0 0 1 2 2v14l-7-3-7 3V6a2 2 0 0 1 2-2z"/></svg></span>
    <div><strong><%= counts.zaken %></strong><span><%= t('dash.total') %></span></div>
  </article>
  <article class="stat">
    <span class="stat-ico ico-open"><svg viewBox="0 0 24 24"><path d="M12 5c5 0 9 4.5 9 7s-4 7-9 7-9-4.5-9-7 4-7 9-7zm0 3a4 4 0 1 0 4 4 4 4 0 0 0-4-4z"/></svg></span>
    <div><strong><%= counts.open %></strong><span><%= t('dash.open') %></span></div>
  </article>
  <article class="stat">
    <span class="stat-ico ico-progress"><svg viewBox="0 0 24 24"><path d="M12 4a8 8 0 1 1-8 8h2a6 6 0 1 0 6-6V4z"/></svg></span>
    <div><strong><%= counts.inProgress %></strong><span><%= t('dash.progress') %></span></div>
  </article>
  <article class="stat">
    <span class="stat-ico ico-closed"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 1-9 9 9 9 0 0 1 9-9zm-1.2 12.4 6-6-1.4-1.4-4.6 4.6-2.2-2.2-1.4 1.4z"/></svg></span>
    <div><strong><%= counts.closed %></strong><span><%= t('dash.closed') %></span></div>
  </article>
</section>

<section class="registry">
  <article>
    <span class="stat-ico ico-people"><svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v2h16v-2c0-2.8-3.6-5-8-5z"/></svg></span>
    <div><strong><%= counts.personen %></strong><span><%= t('nav.persons') %></span></div>
  </article>
  <article>
    <span class="stat-ico ico-co"><svg viewBox="0 0 24 24"><path d="M3 21V8l6-4 6 4v13H3zm14 0V10h4v11z"/></svg></span>
    <div><strong><%= counts.bedrijven %></strong><span><%= t('nav.companies') %></span></div>
  </article>
</section>

<div class="grid-2 dash-mid">
  <section class="panel">
    <h2><%= t('dash.split') %></h2>
    <div class="status-bar" aria-hidden="true">
      <% segments.forEach(function (s) { if (s.n) { %>
        <span class="seg-<%= s.cls %>" style="flex: <%= s.n %>"></span>
      <% } }) %>
    </div>
    <ul class="legend">
      <li><i class="dot open"></i> <%= t('dash.open') %> <b><%= counts.byStatus.nieuw %></b></li>
      <li><i class="dot wait"></i> <%= t('dash.waiting') %> <b><%= counts.byStatus.wacht_op_info %></b></li>
      <li><i class="dot progress"></i> <%= t('dash.progress') %> <b><%= counts.byStatus.in_behandeling %></b></li>
      <li><i class="dot closed"></i> <%= t('dash.closed') %> <b><%= counts.byStatus.afgerond %></b></li>
    </ul>
  </section>

  <section class="panel overdue">
    <h2>
      <svg viewBox="0 0 24 24"><path d="M12 3 2 21h20zm1 14h-2v2h2zm0-8h-2v6h2z"/></svg>
      <%= t('dash.overdue') %>
    </h2>
    <% if (!overdue.length) { %>
      <p class="muted"><%= t('dash.noOverdue') %></p>
    <% } else { %>
      <ul class="overdue-list">
        <% overdue.forEach(function (z) { %>
        <li>
          <a href="/zaken/<%= z.id %>">
            <strong><%= z.titel %></strong>
            <span class="mono"><%= z.zaaknummer %></span>
          </a>
          <span class="badge-overdue"><%= t('dash.overdueBadge') %></span>
        </li>
        <% }) %>
      </ul>
    <% } %>
    <a class="ghost" href="/zaken"><%= t('dash.viewAll') %></a>
  </section>
</div>

<div class="grid-2">
  <section class="panel">
    <header>
      <h2><%= t('dash.recentCases') %></h2>
      <a href="/zaken"><%= t('dash.viewAll') %></a>
    </header>
    <% if (!zaken.length) { %>
      <p class="muted"><%= t('dash.noCases') %></p>
    <% } else { %>
      <ul class="case-feed">
        <% zaken.forEach(function (z) { %>
        <li>
          <a href="/zaken/<%= z.id %>"><%= z.titel %></a>
          <span class="badge badge-<%= z.status %>"><%= t('status.' + z.status) %></span>
          <small><%= formatDate(z.createdAt) %></small>
        </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <section class="panel">
    <header>
      <h2><%= t('dash.recentDocs') %></h2>
    </header>
    <% if (!documenten.length) { %>
      <p class="muted"><%= t('dash.noDocs') %></p>
    <% } else { %>
      <ul class="doc-feed">
        <% documenten.forEach(function (d) { %>
        <li>
          <a href="/zaken/<%= d.zaakId %>/bijlagen/<%= d.id %>"<% if (/pdf/i.test(d.mime || "") || /\.pdf$/i.test(d.naam || "")) { %> data-pdf-preview data-pdf-name="<%= d.naam %>"<% } %>><%= d.naam %></a>
          <p><%= d.zaaknummer %> · <%= d.zaakTitel %></p>
          <small><%= formatDateTime(d.at) %></small>
        </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

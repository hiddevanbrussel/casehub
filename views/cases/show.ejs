<%
  const stufOn = Boolean(typeof stufReady !== "undefined" && stufReady);
  const createOn = Boolean(typeof createEnabled !== "undefined" && createEnabled);
  const canGenerate = Boolean(createReady && (recipes.length || stufOn));
  const generateMode = stufOn && !createOn ? "interactive" : "generate";
  const persons = zaak.personen || [];
  const companies = zaak.bedrijven || [];
  const events = typeof activity !== "undefined" ? activity : [];
  const recentEvents = events.slice(0, 3);
  const docRows = documentRows(zaak, { basePath: "/zaken/" + zaak.id });
  function whenLabel(iso) {
    if (!iso) return "";
    const bucket = dayBucket(iso);
    if (bucket === "today") return t("dash.todayAt", { time: formatTime(iso) });
    if (bucket === "yesterday") return t("dash.yesterdayAt", { time: formatTime(iso) });
    return formatDateTimeShort(iso);
  }
  function activityTitle(ev) {
    if (ev.entity === "document" || ev.action === "bijlage") return t("cases.activityDoc", { name: ev.detail || "" });
    if (ev.action === "aangemaakt") return t("cases.activityCreated");
    if (ev.action === "gewijzigd") return t("cases.activityUpdated");
    if (ev.detail) return ev.detail;
    return t("cases.activityUpdated");
  }
  const tabId = tab || "overview";
  const tabs = [
    { id: "overview", href: "/zaken/" + zaak.id, label: t("cases.tabOverview") },
    { id: "activity", href: "/zaken/" + zaak.id + "?tab=activity", label: t("cases.tabActivity") },
    { id: "documents", href: "/zaken/" + zaak.id + "?tab=documents", label: t("cases.docsCount", { n: docRows.length }) },
    { id: "relations", href: "/zaken/" + zaak.id + "?tab=relations", label: t("cases.tabRelations") },
  ];
%>
<div class="case-page">
  <a class="case-back-text" href="/zaken">
    <%- icon("chevron-left") %>
    <%= t("common.back") %>
  </a>

  <div class="case-top">
    <div class="case-title">
      <p class="case-id"><%= zaak.zaaknummer %></p>
      <div class="case-heading">
        <h1><%= zaak.titel %></h1>
        <% if (quickStatusChange) { %>
        <form method="post" action="/zaken/<%= zaak.id %>/status" class="status-menu">
          <details>
            <summary class="case-status badge-<%= zaak.status %>" aria-label="<%= t('cases.changeStatus') %>">
              <%= t("status." + zaak.status) %>
              <%- icon("chevron-down") %>
            </summary>
            <div class="menu-dots-list">
              <% statussen.forEach(function (s) { %>
                <button type="submit" name="status" value="<%= s.id %>" class="<%= zaak.status === s.id ? 'is-current' : '' %>"><%= t("status." + s.id) %></button>
              <% }) %>
            </div>
          </details>
        </form>
        <% } else { %>
        <span class="case-status badge-<%= zaak.status %>"><%= t("status." + zaak.status) %></span>
        <% } %>
      </div>
    </div>
    <div class="actions">
      <a class="ghost" href="/zaken/<%= zaak.id %>/bewerken"><%- icon("pencil") %> <%= t("common.edit") %></a>
      <details class="menu-dots">
        <summary class="ghost icon-more" aria-label="<%= t('cases.more') %>">
          <%- icon("ellipsis") %>
        </summary>
        <div class="menu-dots-list">
          <% if (createOn && recipes.length) { %>
          <button type="button" data-generate-open="generate" <%= canGenerate ? "" : "disabled" %>><%= t("cases.generateDoc") %></button>
          <% } %>
          <% if (stufOn) { %>
          <button type="button" data-generate-open="interactive" <%= canGenerate ? "" : "disabled" %>><%= t("cases.generateInteractive") %></button>
          <% } %>
          <form method="post" action="/zaken/<%= zaak.id %>/verwijderen" data-confirm="<%= t('cases.confirmDelete') %>">
            <button class="danger-text" type="submit"><%= t("common.delete") %></button>
          </form>
        </div>
      </details>
    </div>
  </div>

  <dl class="case-meta">
    <div class="case-meta-item">
      <dt><%= t("cases.reference") %></dt>
      <dd><%= zaak.referentie || "—" %></dd>
    </div>
    <% if (zaak.zaaktype) { %>
    <div class="case-meta-item">
      <dt><%= t("cases.type") %></dt>
      <dd><%= zaak.zaaktype %></dd>
    </div>
    <% } %>
    <div class="case-meta-item">
      <dt><%= t("cases.assignee") %></dt>
      <dd><%= zaak.behandelaarNaam || "—" %></dd>
    </div>
    <div class="case-meta-item">
      <dt><%= t("cases.startDate") %></dt>
      <dd><%= formatDateLong(zaak.startdatum || zaak.createdAt) %></dd>
    </div>
    <div class="case-meta-item">
      <dt><%= t("cases.endDate") %></dt>
      <dd class="<%= zaak.overdue ? 'is-overdue' : '' %>"><%= zaak.deadline ? formatDateLong(zaak.deadline) : "—" %></dd>
    </div>
  </dl>

  <nav class="case-tabs" aria-label="<%= zaak.titel %>">
    <% tabs.forEach(function (item) { %>
      <a class="<%= tabId === item.id ? 'is-active' : '' %>" href="<%= item.href %>"><%= item.label %></a>
    <% }) %>
  </nav>

  <% if (tabId === "overview") { %>
  <div class="case-split">
    <div class="case-main">
      <section class="case-body">
        <h2><%= t("cases.descriptionTitle") %></h2>
        <p class="case-copy"><%= zaak.omschrijving || t("cases.noDescription") %></p>
      </section>
      <section class="case-panel">
        <header class="case-panel-head">
          <h2><%= t("cases.recentActivity") %></h2>
          <% if (events.length) { %>
            <a href="/zaken/<%= zaak.id %>?tab=activity"><%= t("dash.viewAllShort") %></a>
          <% } %>
        </header>
        <% if (!recentEvents.length) { %>
          <p class="muted"><%= t("dash.noActivity") %></p>
        <% } else { %>
          <ol class="case-activity">
            <% recentEvents.forEach(function (ev) { %>
            <li>
              <span class="dash-activity-ico ico-<%= ev.entity || 'zaak' %>" aria-hidden="true">
                <% if (ev.entity === "document" || ev.action === "bijlage") { %>
                <%- icon("file-text") %>
                <% } else { %>
                <%- icon("bookmark") %>
                <% } %>
              </span>
              <div>
                <p><%= activityTitle(ev) %></p>
                <small><%= t("cases.activityBy", { name: ev.actor || "—" }) %> · <%= whenLabel(ev.at) %></small>
              </div>
            </li>
            <% }) %>
          </ol>
        <% } %>
      </section>
    </div>
    <aside class="case-side">
      <section class="case-panel">
        <header class="case-panel-head">
          <h2><%= t("cases.linkedDocs") %><% if (docRows.length) { %> (<%= docRows.length %>)<% } %></h2>
          <% if (docRows.length) { %>
          <a href="/zaken/<%= zaak.id %>?tab=documents"><%= t("dash.viewAllShort") %></a>
          <% } %>
        </header>
        <%- include("../partials/doc-list", { docRows: docRows, compact: true, canDelete: false, emptyTitle: t("dash.noDocs") }) %>
        <button type="button" class="case-add" data-generate-open="<%= generateMode %>" <%= canGenerate ? "" : "disabled" %>>
          <%- icon("plus") %>
          <%= t("cases.addDocument") %>
        </button>
      </section>
      <section class="case-panel">
        <header class="case-panel-head">
          <h2><%= t("cases.stakeholders") %></h2>
          <% if (persons.length || companies.length) { %>
            <a href="/zaken/<%= zaak.id %>?tab=relations"><%= t("dash.viewAllShort") %></a>
          <% } %>
        </header>
        <% if (!persons.length && !companies.length) { %>
          <p class="muted"><%= t("cases.noStakeholders") %></p>
        <% } else { %>
          <ul class="case-people">
            <% persons.forEach(function (p) { %>
            <li>
              <span class="who-avatar assignee-av tone-<%= p.id.charCodeAt(0) % 4 %>" aria-hidden="true"><%= String(p.naam || "?").split(/\s+/).map(function (part) { return part[0]; }).slice(0, 2).join("").toUpperCase() %></span>
              <a href="/personen?focus=<%= p.id %>"><%= p.naam %></a>
            </li>
            <% }) %>
            <% companies.forEach(function (b) { %>
            <li>
              <span class="who-avatar assignee-av tone-1" aria-hidden="true">
                <%- icon("building-2") %>
              </span>
              <a href="/bedrijven?focus=<%= b.id %>"><%= b.handelsnaam %></a>
            </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </aside>
  </div>
  <% } else if (tabId === "activity") { %>
  <section class="case-panel">
    <h2><%= t("cases.tabActivity") %></h2>
    <% if (!events.length) { %>
      <p class="muted"><%= t("dash.noActivity") %></p>
    <% } else { %>
      <ol class="case-activity">
        <% events.forEach(function (ev) { %>
        <li>
          <span class="dash-activity-ico ico-<%= ev.entity || 'zaak' %>" aria-hidden="true">
            <% if (ev.entity === "document" || ev.action === "bijlage") { %>
            <%- icon("file-text") %>
            <% } else { %>
            <%- icon("bookmark") %>
            <% } %>
          </span>
          <div>
            <p><%= activityTitle(ev) %></p>
            <small><%= t("cases.activityBy", { name: ev.actor || "—" }) %> · <%= whenLabel(ev.at) %></small>
          </div>
        </li>
        <% }) %>
      </ol>
    <% } %>
  </section>
  <% } else if (tabId === "documents") { %>
  <section class="case-panel">
    <header class="case-panel-head">
      <h2><%= t("cases.tabDocuments") %></h2>
      <button type="button" class="linkish" data-generate-open="<%= generateMode %>" <%= canGenerate ? "" : "disabled" %>><%= t("cases.addDocument") %></button>
    </header>
    <%- include("../partials/doc-list", {
      docRows: docRows,
      emptyTitle: t("cases.docEmpty"),
      emptyHint: canGenerate ? t("cases.docEmptyHint") : t("cases.generateNeedsIntegration"),
    }) %>
  </section>
  <% } else { %>
  <section class="case-panel">
    <h2><%= t("cases.stakeholders") %></h2>
    <% if (!persons.length && !companies.length) { %>
      <p class="muted"><%= t("cases.noStakeholders") %></p>
    <% } else { %>
      <% if (persons.length) { %>
        <h3 class="case-sub"><%= t("cases.persons") %></h3>
        <ul class="case-people">
          <% persons.forEach(function (p) { %>
          <li>
            <span class="who-avatar assignee-av tone-<%= p.id.charCodeAt(0) % 4 %>" aria-hidden="true"><%= String(p.naam || "?").split(/\s+/).map(function (part) { return part[0]; }).slice(0, 2).join("").toUpperCase() %></span>
            <div>
              <a href="/personen?focus=<%= p.id %>"><%= p.naam %></a>
              <% if (p.email) { %><small><%= p.email %></small><% } %>
            </div>
          </li>
          <% }) %>
        </ul>
      <% } %>
      <% if (companies.length) { %>
        <h3 class="case-sub"><%= t("cases.companies") %></h3>
        <ul class="case-people">
          <% companies.forEach(function (b) { %>
          <li>
            <span class="who-avatar assignee-av tone-1" aria-hidden="true">
              <%- icon("building-2") %>
            </span>
            <div>
              <a href="/bedrijven?focus=<%= b.id %>"><%= b.handelsnaam %></a>
              <% if (b.plaats) { %><small><%= b.plaats %></small><% } %>
            </div>
          </li>
          <% }) %>
        </ul>
      <% } %>
    <% } %>
  </section>
  <% } %>

  <%- include("../partials/generate-doc", {
    action: "/zaken/" + zaak.id + "/documenten",
    recipes: recipes,
    canGenerate: canGenerate,
    hideButtons: true,
    stakeholders: [].concat(
      (zaak.personen || []).map(function (p) { return { key: "persoon:" + p.id, kind: "persoon", name: p.naam || "" }; }),
      (zaak.bedrijven || []).map(function (b) { return { key: "bedrijf:" + b.id, kind: "bedrijf", name: b.handelsnaam || "" }; })
    )
  }) %>
</div>

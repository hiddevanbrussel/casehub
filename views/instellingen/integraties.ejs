<%
  function statusBadge(ready, active) {
    if (!ready) return { cls: "badge-wacht_op_info", label: t("common.notConfigured") };
    if (active === false) return { cls: "badge-in_behandeling", label: t("common.paused") };
    return { cls: "badge-afgerond", label: t("common.connected") };
  }
  const createBadge = statusBadge(createReady, create.active);
  const stufBadge = statusBadge(stufReady, stuf.active);
  const azureBadge = statusBadge(azureReady, azure.active);
%>
<p class="back-link"><a href="/instellingen"><%= t("settings.back") %></a></p>
<div class="page-head">
  <div>
    <h1><%= t("integrations.title") %></h1>
    <p class="lede"><%= t("integrations.lede") %></p>
  </div>
</div>

<div class="int-stack">
  <form method="post" action="/instellingen/integraties/active" class="form-card int-card">
    <input type="hidden" name="azureActive" value="<%= azure.active !== false ? "1" : "0" %>">
    <input type="hidden" name="stufActive" value="<%= stuf.active !== false ? "1" : "0" %>">
    <header class="int-card-head">
      <%- icon("file-plus", { class: "set-ico" }) %>
      <div>
        <h2><%= t("integrations.createName") %></h2>
        <p><%= t("integrations.createAbout") %></p>
      </div>
      <span class="badge <%= createBadge.cls %>"><%= createBadge.label %></span>
    </header>
    <% if (createReady) { %><p class="int-card-meta"><%= createSummary %></p><% } %>
    <% if (create.lastError) { %><p class="int-card-error"><%= create.lastError %></p><% } %>
    <% if (create.lastSyncAt) { %><p class="hint"><%= t("create.lastSync") %> <%= formatDateTime(create.lastSyncAt) %></p><% } %>
    <% if (create.lastWebhookAt) { %>
    <p class="hint">
      <%= t("create.lastWebhook") %>
      <%= formatDateTime(create.lastWebhookAt) %>
      · <%= t("create.webhookStatus." + (create.lastWebhookStatus || "ok")) %>
      <% if (create.lastWebhookDetail) { %> · <%= create.lastWebhookDetail %><% } %>
    </p>
    <% } else { %>
    <p class="hint"><%= t("create.lastWebhookNone") %></p>
    <% } %>
    <footer class="int-card-foot">
      <% if (createReady) { %>
      <label class="set-toggle is-compact">
        <span><strong><%= t("integrations.active") %></strong></span>
        <input type="hidden" name="createActive" value="0">
        <input type="checkbox" name="createActive" value="1" data-auto-submit <%= create.active !== false ? "checked" : "" %> aria-label="Create <%= t('integrations.active') %>">
      </label>
      <% } else { %>
      <input type="hidden" name="createActive" value="<%= create.active !== false ? "1" : "0" %>">
      <% } %>
      <a class="<%= createReady ? "ghost" : "btn" %>" href="/instellingen/integraties/create"><%= t("integrations.configure") %></a>
      <% if (createReady) { %>
      <button class="ghost" type="submit" form="create-test"><%= t("integrations.test") %></button>
      <button class="ghost" type="submit" form="create-sync"><%= t("integrations.sync") %></button>
      <% } %>
    </footer>
  </form>

  <form method="post" action="/instellingen/integraties/active" class="form-card int-card">
    <input type="hidden" name="createActive" value="<%= create.active !== false ? "1" : "0" %>">
    <input type="hidden" name="azureActive" value="<%= azure.active !== false ? "1" : "0" %>">
    <header class="int-card-head">
      <%- icon("file-output", { class: "set-ico" }) %>
      <div>
        <h2><%= t("integrations.stufName") %></h2>
        <p><%= t("integrations.stufAbout") %></p>
      </div>
      <span class="badge <%= stufBadge.cls %>"><%= stufBadge.label %></span>
    </header>
    <% if (stufReady) { %><p class="int-card-meta"><%= stufSummary %></p><% } %>
    <% if (stuf.lastError) { %><p class="int-card-error"><%= stuf.lastError %></p><% } %>
    <% if (stuf.lastResultAt) { %>
    <p class="hint">
      <%= t("stuf.lastResult") %>
      <%= formatDateTime(stuf.lastResultAt) %>
      · <%= t("stuf.status." + (stuf.lastResultStatus || "ok")) %>
      <% if (stuf.lastResultDetail) { %> · <%= stuf.lastResultDetail %><% } %>
    </p>
    <% } else { %>
    <p class="hint"><%= t("stuf.lastResultNone") %></p>
    <% } %>
    <footer class="int-card-foot">
      <% if (stufReady) { %>
      <label class="set-toggle is-compact">
        <span><strong><%= t("integrations.active") %></strong></span>
        <input type="hidden" name="stufActive" value="0">
        <input type="checkbox" name="stufActive" value="1" data-auto-submit <%= stuf.active !== false ? "checked" : "" %> aria-label="StUF-DCR <%= t('integrations.active') %>">
      </label>
      <% } else { %>
      <input type="hidden" name="stufActive" value="<%= stuf.active !== false ? "1" : "0" %>">
      <% } %>
      <a class="<%= stufReady ? "ghost" : "btn" %>" href="/instellingen/integraties/stuf-dcr"><%= t("integrations.configure") %></a>
    </footer>
  </form>

  <form method="post" action="/instellingen/integraties/active" class="form-card int-card">
    <input type="hidden" name="createActive" value="<%= create.active !== false ? "1" : "0" %>">
    <input type="hidden" name="stufActive" value="<%= stuf.active !== false ? "1" : "0" %>">
    <header class="int-card-head">
      <%- icon("key-round", { class: "set-ico" }) %>
      <div>
        <h2><%= t("integrations.azureName") %></h2>
        <p><%= t("integrations.azureAbout") %></p>
      </div>
      <span class="badge <%= azureBadge.cls %>"><%= azureBadge.label %></span>
    </header>
    <% if (azureReady) { %><p class="int-card-meta"><%= azureSummary %></p><% } %>
    <% if (azure.lastError) { %><p class="int-card-error"><%= azure.lastError %></p><% } %>
    <footer class="int-card-foot">
      <% if (azureReady) { %>
      <label class="set-toggle is-compact">
        <span><strong><%= t("integrations.active") %></strong></span>
        <input type="hidden" name="azureActive" value="0">
        <input type="checkbox" name="azureActive" value="1" data-auto-submit <%= azure.active !== false ? "checked" : "" %> aria-label="Microsoft Entra ID <%= t('integrations.active') %>">
      </label>
      <% } else { %>
      <input type="hidden" name="azureActive" value="<%= azure.active !== false ? "1" : "0" %>">
      <% } %>
      <a class="<%= azureReady ? "ghost" : "btn" %>" href="/instellingen/integraties/azure"><%= t("integrations.configure") %></a>
    </footer>
  </form>
</div>
<form id="create-test" method="post" action="/instellingen/create/test" hidden></form>
<form id="create-sync" method="post" action="/templates/sync" hidden></form>

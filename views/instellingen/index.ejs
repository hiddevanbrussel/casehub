  <a href="/instellingen/werkruimtes">
    <%- icon("building-2", { class: "set-ico" }) %>
    <span>
      <strong><%= t("workspace.manage") %></strong>
      <small><%= t("workspace.manageHint") %></small>
    </span>
    <span class="chev" aria-hidden="true">›</span>
  </a>
  <a href="/instellingen/beheerders">
    <%- icon("shield-check", { class: "set-ico" }) %>
    <span>
      <strong><%= t("admins.manage") %></strong>
      <small><%= t("admins.manageHint") %></small>
    </span>
    <span class="chev" aria-hidden="true">›</span>
  </a>
  <% } %>
  <a href="/instellingen/algemeen">
    <%- icon("settings", { class: "set-ico" }) %>

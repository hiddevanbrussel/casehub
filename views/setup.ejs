<% const setupKind = typeof kind !== "undefined" ? kind : "tenant"; %>
<%
  let setupTitle = t("onboard.title");
  let setupLede = setupKind === "platform" ? t("onboard.platformLede") : t("onboard.lede");
  if (step === "firstWorkspace") {
    setupTitle = t("onboard.firstWorkspace");
    setupLede = t("onboard.firstWorkspaceLede");
  } else if (step === "admin") {
    setupTitle = setupKind === "platform" ? t("onboard.title") : t("onboard.admin");
    setupLede = setupKind === "platform" ? t("onboard.adminPlatformLede") : t("onboard.adminLede");
  } else if (step === "org") {
    setupTitle = t("onboard.org");
    setupLede = t("onboard.orgLede");
  } else if (step === "profile") {
    setupTitle = t("onboard.profile");
    setupLede = t("onboard.profileLede");
  } else if (step === "create") {
    setupTitle = t("onboard.create");
    setupLede = t("onboard.createLede");
  } else if (step === "azure") {
    setupTitle = t("onboard.azure");
    setupLede = setupKind === "platform" ? t("onboard.azurePlatformLede") : t("onboard.azureLede");
  } %}
%>
<!DOCTYPE html>
<html lang="<%= lang %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= setupTitle %> · <%= meta.orgName %></title>
  <link rel="icon" href="/public/brand/mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/app.css?v=ws-onboard-4">
</head>
<body class="login-body">
  <main class="login-card setup-card">
    <div class="setup-top">
      <div class="brand brand-lg">
        <%- include("partials/brand-mark") %>
        <strong><%= meta.orgName %></strong>
      </div>
      <div class="login-lang">
        <%- include("partials/theme-toggle") %>
        <%- include("partials/lang-switcher") %>
      </div>
    </div>
    <ol class="setup-steps" aria-label="<%= t('onboard.stepOf', { n: stepIndex + 1, total: steps.length }) %>">
      <% steps.forEach(function (item, i) { %>
        <li class="<%= i < stepIndex ? 'is-done' : (i === stepIndex ? 'is-active' : '') %>">
          <span class="setup-step-index" aria-hidden="true"><%= i + 1 %></span>
          <%= t('onboard.' + item) %>
        </li>
      <% }) %>
    </ol>
    <header class="setup-intro">
      <h1><%= setupTitle %></h1>
      <p class="lede"><%= setupLede %></p>
    </header>
    <% if (error) { %><p class="alert"><%= error %></p><% } %>

    <% if (step === "org") { %>
    <form method="post" action="/setup">
      <input type="hidden" name="step" value="org">
      <label><%= t('settings.orgName') %>
        <input name="orgName" required autofocus value="<%= values.orgName || meta.orgName %>">
      </label>
      <label><%= t('settings.prefix') %>
        <input name="zaakPrefix" required maxlength="6" value="<%= values.zaakPrefix || meta.zaakPrefix %>">
      </label>
      <div class="setup-actions">
        <button class="btn" type="submit"><%= t('onboard.next') %></button>
      </div>
    </form>
    <% } %>

    <% if (step === "profile") { %>
    <form method="post" action="/setup">
      <input type="hidden" name="step" value="profile">
      <div class="profile-picks">
        <label class="profile-pick">
          <input type="radio" name="appProfile" value="cases" <%= (values.appProfile || 'cases') === 'cases' ? 'checked' : '' %>>
          <span>
            <strong><%= t('onboard.profileCases') %></strong>
            <small><%= t('onboard.profileCasesHint') %></small>
          </span>
        </label>
        <label class="profile-pick">
          <input type="radio" name="appProfile" value="hr" <%= values.appProfile === 'hr' ? 'checked' : '' %>>
          <span>
            <strong><%= t('onboard.profileHr') %></strong>
            <small><%= t('onboard.profileHrHint') %></small>
          </span>
        </label>
        <label class="profile-pick">
          <input type="radio" name="appProfile" value="both" <%= values.appProfile === 'both' ? 'checked' : '' %>>
          <span>
            <strong><%= t('onboard.profileBoth') %></strong>
            <small><%= t('onboard.profileBothHint') %></small>
          </span>
        </label>
      </div>
      <div class="setup-hr-fields" id="setup-hr-fields" <%= (values.appProfile || 'cases') === 'cases' ? 'hidden' : '' %>>
        <label><%= t('onboard.personeelPrefix') %>
          <input name="personeelPrefix" maxlength="6" value="<%= values.personeelPrefix || 'P' %>">
        </label>
      </div>
      <div class="setup-actions">
        <a class="ghost" href="/setup?step=org"><%= t('onboard.back') %></a>
        <button class="btn" type="submit"><%= t('onboard.next') %></button>
      </div>
    </form>
    <script>
      document.querySelectorAll('input[name="appProfile"]').forEach(function (input) {
        input.addEventListener("change", function () {
          document.getElementById("setup-hr-fields").hidden = input.value === "cases";
        });
      });
    </script>
    <% } %>

    <% if (step === "admin") { %>
    <form method="post" action="/setup">
      <input type="hidden" name="step" value="admin">
      <div class="form-row form-row-2">
        <label><%= t('employees.firstName') %>
          <input name="voornaam" required autofocus value="<%= values.voornaam || '' %>">
        </label>
        <label><%= t('employees.lastName') %>
          <input name="achternaam" required value="<%= values.achternaam || '' %>">
        </label>
      </div>
      <label><%= t('employees.email') %>
        <input type="email" name="email" required value="<%= values.email || '' %>">
      </label>
      <label><%= t('employees.password') %>
        <input type="password" name="wachtwoord" <%= values.id ? "" : "required" %> minlength="8" autocomplete="new-password" placeholder="<%= values.id ? t('employees.keepPassword') : '' %>">
      </label>
      <label><%= t('onboard.passwordConfirm') %>
        <input type="password" name="wachtwoord2" <%= values.id ? "" : "required" %> minlength="8" autocomplete="new-password">
      </label>
      <div class="setup-actions">
        <% if (setupKind !== "platform") { %>
        <a class="ghost" href="/setup?step=profile"><%= t('onboard.back') %></a>
        <button class="btn" type="submit"><%= t('onboard.next') %></button>
        <% } else { %>
        <button class="btn" type="submit"><%= t('onboard.next') %></button>
        <% } %>
      </div>
    </form>
    <% } %>

    <% if (step === "firstWorkspace") { %>
    <form method="post" action="/setup">
      <input type="hidden" name="step" value="firstWorkspace">
      <div class="setup-cluster">
        <label><%= t("workspace.name") %>
          <input name="name" required autofocus value="<%= values.name || '' %>" placeholder="CaseFlow" autocomplete="off">
        </label>
        <div class="form-row form-row-2">
          <label><%= t("workspace.slug") %>
            <input name="slug" value="<%= values.slug || '' %>" placeholder="nl" autocomplete="off">
          </label>
          <label><%= t("workspace.lang") %>
            <select name="defaultLang">
              <% langs.forEach(function (item) { %>
              <option value="<%= item.id %>" <%= (values.defaultLang || lang) === item.id ? "selected" : "" %>><%= item.label %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <p class="hint"><%= t("workspace.slugHint") %></p>
        <label><%= t("workspace.domain") %>
          <input name="domains" value="<%= values.domains || '' %>" placeholder="<%= t("workspace.domainPlaceholder") %>" autocomplete="off">
          <span class="hint"><%= t("workspace.domainHint") %></span>
        </label>
      </div>
      <fieldset class="setup-cluster">
        <legend><%= t("onboard.profile") %></legend>
        <div class="profile-picks">
          <label class="profile-pick">
            <input type="radio" name="appProfile" value="cases" <%= (values.appProfile || "cases") === "cases" ? "checked" : "" %>>
            <span>
              <strong><%= t("onboard.profileCases") %></strong>
              <small><%= t("onboard.profileCasesHint") %></small>
            </span>
          </label>
          <label class="profile-pick">
            <input type="radio" name="appProfile" value="hr" <%= values.appProfile === "hr" ? "checked" : "" %>>
            <span>
              <strong><%= t("onboard.profileHr") %></strong>
              <small><%= t("onboard.profileHrHint") %></small>
            </span>
          </label>
          <label class="profile-pick">
            <input type="radio" name="appProfile" value="both" <%= values.appProfile === "both" ? "checked" : "" %>>
            <span>
              <strong><%= t("onboard.profileBoth") %></strong>
              <small><%= t("onboard.profileBothHint") %></small>
            </span>
          </label>
        </div>
      </fieldset>
      <fieldset class="setup-cluster">
        <legend><%= t("workspace.admin") %></legend>
        <p class="hint"><%= t("workspace.adminLede") %></p>
        <div class="form-row form-row-2">
          <label><%= t("employees.firstName") %>
            <input name="adminVoornaam" required value="<%= values.adminVoornaam || '' %>" autocomplete="off">
          </label>
          <label><%= t("employees.lastName") %>
            <input name="adminAchternaam" required value="<%= values.adminAchternaam || '' %>" autocomplete="off">
          </label>
        </div>
        <label><%= t("employees.email") %>
          <input type="email" name="adminEmail" required value="<%= values.adminEmail || '' %>" autocomplete="off">
        </label>
        <label><%= t("employees.password") %>
          <input type="password" name="adminWachtwoord" required minlength="8" autocomplete="new-password">
        </label>
      </fieldset>
      <input type="hidden" name="seedDemo" value="0">
      <label class="set-toggle">
        <span>
          <strong><%= t("workspace.seedDemo") %></strong>
          <small><%= t("workspace.seedHint") %></small>
        </span>
        <input type="checkbox" name="seedDemo" value="1" <%= values.seedDemo ? "checked" : "" %>>
      </label>
      <div class="setup-actions">
        <a class="ghost" href="/setup?step=admin"><%= t("onboard.back") %></a>
        <button class="btn" type="submit"><%= t("onboard.next") %></button>
      </div>
    </form>
    <% } %>

    <% if (step === "create") { %>
    <form method="post" action="/setup">
      <input type="hidden" name="step" value="create">
      <label><%= t('create.baseUrl') %>
        <input name="baseUrl" value="<%= values.baseUrl || 'https://app.omnidocs.cloud' %>">
      </label>
      <div class="form-row form-row-2">
        <label><%= t('create.clientId') %>
          <input name="clientId" value="<%= values.clientId || '' %>" autocomplete="off">
        </label>
        <label><%= t('create.clientSecret') %>
          <input name="clientSecret" type="password" value="" autocomplete="new-password">
        </label>
      </div>
      <div class="form-row form-row-2">
        <label><%= t('create.unitId') %>
          <input name="unitId" value="<%= values.unitId || '' %>">
        </label>
        <label><%= t('create.contentSourceId') %>
          <input name="contentSourceId" value="<%= values.contentSourceId || '' %>">
        </label>
      </div>
      <label><%= t('create.authDomain') %>
        <input name="authDomain" value="<%= values.authDomain || '' %>" placeholder="auth.example.com" autocomplete="off">
      </label>
      <div class="setup-actions">
        <a class="ghost" href="/setup?step=admin"><%= t('onboard.back') %></a>
        <button class="ghost" type="submit" name="skip" value="1"><%= t('onboard.skip') %></button>
        <button class="btn" type="submit"><%= t('onboard.next') %></button>
      </div>
    </form>
    <% } %>

    <% if (step === "azure") { %>
    <form method="post" action="/setup">
      <input type="hidden" name="step" value="azure">
      <label><%= t('azure.tenantId') %>
        <input name="tenantId" value="<%= values.tenantId || '' %>" autocomplete="off">
      </label>
      <label><%= t('azure.clientId') %>
        <input name="clientId" value="<%= values.clientId || '' %>" autocomplete="off">
      </label>
      <label><%= t('azure.clientSecret') %>
        <input name="clientSecret" type="password" value="" autocomplete="new-password">
      </label>
      <label><%= t('azure.redirectUri') %>
        <input value="<%= redirectUri %>" readonly>
      </label>
      <p class="hint"><%= t('azure.redirectHint') %></p>
      <div class="setup-actions">
        <a class="ghost" href="/setup?step=<%= setupKind === 'platform' ? 'firstWorkspace' : 'create' %>"><%= t('onboard.back') %></a>
        <button class="ghost" type="submit" name="skip" value="1"><%= t('onboard.skip') %></button>
        <% if (setupKind === "platform") { %>
        <button class="ghost" type="submit" name="link" value="1"><%= t("onboard.azureLink") %></button>
        <% } %>
        <button class="btn" type="submit"><%= t('onboard.finish') %></button>
      </div>
    </form>
    <% } %>
  </main>
  <%- include("partials/boot") %>
  <script src="/public/js/theme.js?v=boot"></script>
</body>
</html>

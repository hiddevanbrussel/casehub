<!DOCTYPE html>
<html lang="<%= lang %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= meta.orgName %></title>
  <link rel="icon" href="/public/brand/mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/app.css?v=stuf-sheet-1">
</head>
<body>
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="/">
      <%- include("partials/brand-mark") %>
      <strong><%= meta.orgName %></strong>
    </a>
    <nav>
      <p class="nav-label"><%= t('nav.home') %></p>
      <a class="<%= path === '/' ? 'is-active' : '' %>" href="/" data-tour="dash">
        <%- icon("layout-dashboard") %>
        <%= t('nav.dashboard') %>
      </a>
      <% if (isCases) { %>
      <a class="<%= navActive('/zaken') %>" href="/zaken" data-tour="cases">
        <%- icon("bookmark") %>
        <%= t('nav.cases') %>
      </a>
      <% } %>
      <% if (isHr) { %>
      <a class="<%= navActive('/werknemers') %>" href="/werknemers" data-tour="employees">
        <%- icon("users") %>
        <%= t('nav.employees') %>
      </a>
      <% } %>

      <% if (isCases) { %>
      <p class="nav-label"><%= t('nav.naw') %></p>
      <a class="<%= navActive('/personen') %>" href="/personen" data-tour="persons">
        <%- icon("user") %>
        <%= t('nav.persons') %>
      </a>
      <a class="<%= navActive('/bedrijven') %>" href="/bedrijven">
        <%- icon("building-2") %>
        <%= t('nav.companies') %>
      </a>
      <% } %>

      <% if (typeof isAdmin !== "undefined" && isAdmin) { %>
      <p class="nav-label"><%= t('nav.admin') %></p>
      <% if (!isHr) { %>
      <a class="<%= navActive('/werknemers') %>" href="/werknemers" data-tour="employees">
        <%- icon("users") %>
        <%= t('nav.employees') %>
      </a>
      <% } %>
      <a class="<%= navActive('/audit') %>" href="/audit">
        <%- icon("scroll-text") %>
        <%= t('nav.audit') %>
      </a>
      <a class="<%= navActive('/instellingen') %>" href="/instellingen" data-tour="settings">
        <%- icon("settings") %>
        <%= t('nav.settings') %>
      </a>
      <% } %>
    </nav>

  </aside>

  <div class="shell">
    <header class="topbar">
      <label class="top-search" data-tour="search">
        <%- icon("search") %>
        <input type="search" placeholder="<%= t('search.top', { org: meta.orgName }) %>" data-palette-open readonly>
      </label>
      <div class="topbar-end">
        <%- include("partials/theme-toggle") %>
        <%- include("partials/lang-switcher") %>
        <% if (user) { %>
        <% const initials = String(user.naam || "?").split(/\s+/).filter(Boolean).map(function (part) { return part[0]; }).slice(0, 2).join("").toUpperCase(); %>
        <div class="top-who">
          <span class="who-avatar" aria-hidden="true"><%= initials %></span>
          <strong><%= user.naam %></strong>
          <% if (typeof isGlobalAdmin !== "undefined" && isGlobalAdmin && typeof workspaces !== "undefined" && workspaces.length) { %>
          <a class="who-out" href="/instellingen/werkruimtes" title="<%= t('workspace.switch') %>" aria-label="<%= t('workspace.switch') %>"><%- icon("building-2") %></a>
          <% } %>
          <form method="post" action="/logout">
            <button class="who-out" type="submit" title="<%= t('nav.signOut') %>" aria-label="<%= t('nav.signOut') %>">
              <%- icon("log-out") %>
            </button>
          </form>
        </div>
        <% } %>
      </div>
    </header>
    <main class="content<%= path === '/instellingen' || path.indexOf('/instellingen/') === 0 ? ' is-settings' : '' %><%= typeof contentMod === 'string' ? contentMod : '' %>">
      <%- body %>
    </main>
  </div>

  <dialog class="palette" id="palette">
    <input id="palette-q" placeholder="<%= t('search.placeholder') %>" autocomplete="off">
    <div id="palette-results"></div>
  </dialog>
  <dialog class="edit-modal" id="edit-modal"></dialog>
  <dialog class="pdf-modal" id="pdf-modal">
    <div class="modal-head">
      <h1 id="pdf-modal-title"><%= t('cases.tabDocuments') %></h1>
      <button type="button" class="icon-btn" data-modal-close aria-label="<%= t('common.close') %>"><%- icon("x") %></button>
    </div>
    <iframe id="pdf-modal-frame" title="PDF"></iframe>
    <footer class="modal-foot">
      <a class="ghost" id="pdf-modal-download" href="#" download><%= t('common.download') %></a>
      <button type="button" class="btn" data-modal-close><%= t('common.close') %></button>
    </footer>
  </dialog>

  <%- include("partials/boot") %>
  <% if (toast) { %>
  <div class="toast" role="status"><%= toast %></div>
  <% } %>
  <script>window.I18N = <%- JSON.stringify({ nothing: t("search.nothing"), cases: t("nav.cases"), companies: t("nav.companies"), persons: t("nav.persons"), employees: t("nav.employees"), selected: t("templates.selected"), allAllowed: t("templates.allAllowed"), download: t("common.download"), generateDoc: t("cases.generateDoc"), generateInteractive: t("cases.generateInteractive"), generating: t("cases.generating"), stakeNoMatch: t("cases.stakeholderNoMatch"), loading: t("common.loading"), loadError: t("common.loadError") }) %>;</script>
  <template id="icon-chevron-down"><%- icon("chevron-down") %></template>
  <div class="tour" id="tour" hidden>
    <div class="tour-scrim" data-tour-scrim></div>
    <div class="tour-spot" data-tour-spot></div>
    <div class="tour-card" data-tour-card role="region" aria-labelledby="tour-title" aria-live="polite">
      <div class="tour-head">
        <h2 id="tour-title" data-tour-title></h2>
        <span class="tour-progress" data-tour-progress></span>
      </div>
      <p data-tour-body></p>
      <div class="tour-actions">
        <button type="button" class="ghost" data-tour-skip></button>
        <div class="tour-move">
          <button type="button" class="ghost" data-tour-back></button>
          <button type="button" class="btn" data-tour-next></button>
        </div>
      </div>
    </div>
  </div>
  <script src="/public/js/theme.js?v=boot"></script>
  <script src="/public/js/app.js?v=stuf-tabs-1"></script>
  <% if (typeof tour !== "undefined" && tour) { %>
  <script>window.TOUR = <%- JSON.stringify(tour) %>;</script>
  <script src="/public/js/tour.js?v=3"></script>
  <% } %>
</body>
</html>

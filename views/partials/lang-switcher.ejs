<details class="lang">
  <summary>
    <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9 9 9 0 0 0-9-9zm0 2c.6 2.2 1 4.4 1 7s-.4 4.8-1 7c-.6-2.2-1-4.4-1-7s.4-4.8 1-7zm-7.2 8h4.4c.2 2 .6 3.9 1.2 5.6A7 7 0 0 1 4.8 13zm14.4 0a7 7 0 0 1-5.2 5.6c.6-1.7 1-3.6 1.2-5.6z"/></svg>
    <%= langMeta.short %>
  </summary>
  <div class="lang-menu">
    <% langs.forEach(function (l) { %>
    <form method="post" action="/lang">
      <input type="hidden" name="lang" value="<%= l.id %>">
      <input type="hidden" name="next" value="<%= currentUrl %>">
      <button type="submit" class="<%= l.id === lang ? 'is-active' : '' %>"><%= l.short %> · <%= l.label %></button>
    </form>
    <% }) %>
  </div>
</details>

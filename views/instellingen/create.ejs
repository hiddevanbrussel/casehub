<%
  const tabs = [
    { id: "connection", label: t("create.tabConnection") },
    { id: "webhooks", label: t("create.tabWebhooks") },
  ];
  const activeTab = tabs.some(function (tab) { return tab.id === createTab; }) ? createTab : "connection";
  const catalog = typeof createCatalog === "undefined" || !createCatalog
    ? { organizations: [], units: [], organizationId: create.organizationId || "", error: "", needsCredentials: true }
    : createCatalog;
  const orgOptions = Array.isArray(catalog.organizations) ? catalog.organizations : [];
  const unitOptions = Array.isArray(catalog.units) ? catalog.units : [];
  const useOrgSelect = orgOptions.length > 0;
  const selectedOrg = catalog.organizationId || create.organizationId || "";
  const selectedUnit = create.unitId || "";
  const orgInList = orgOptions.some(function (org) { return org.id === selectedOrg; });
  const unitInList = unitOptions.some(function (unit) { return unit.id === selectedUnit; });
%>
<p class="back-link"><a href="/instellingen/integraties"><%= t("integrations.back") %></a></p>
<% if (create.lastError) { %><p class="alert"><%= create.lastError %></p><% } %>
<% if (catalog.error) { %><p class="alert"><%= t("create.catalogError", { msg: catalog.error }) %></p><% } %>
<form class="form settings-sheet" method="post" action="/instellingen/create" data-form-tabs data-create-catalog>
  <input type="hidden" name="createTab" value="<%= activeTab %>" data-form-tab-value>
  <div class="settings-sheet-head">
    <div class="settings-sheet-title">
      <span class="catalog-tile-ico" aria-hidden="true"><%- icon("file-plus") %></span>
      <div>
        <div class="settings-sheet-heading">
          <h1><%= t("create.title") %></h1>
          <span class="badge <%= createReady ? "badge-afgerond" : "badge-wacht_op_info" %>"><%= createReady ? t("common.connected") : t("common.notConfigured") %></span>
        </div>
        <p class="lede"><%= t("create.lede") %></p>
      </div>
    </div>
    <div class="settings-tabs" role="tablist" aria-label="<%= t("create.title") %>">
      <% tabs.forEach(function (tab) { %>
      <% const on = tab.id === activeTab; %>
      <button type="button" class="<%= on ? "is-active" : "" %>" role="tab" id="create-tab-<%= tab.id %>" aria-controls="create-panel-<%= tab.id %>" aria-selected="<%= on ? "true" : "false" %>" tabindex="<%= on ? "0" : "-1" %>" data-form-tab="<%= tab.id %>">
        <%= tab.label %>
      </button>
      <% }) %>
    </div>
  </div>
  <div class="settings-sheet-body">

  <section class="settings-panel" role="tabpanel" id="create-panel-connection" aria-labelledby="create-tab-connection" data-form-panel="connection"<% if (activeTab !== "connection") { %> hidden<% } %>>
    <label><%= t("create.baseUrl") %>
      <input name="baseUrl" class="settings-url" required value="<%= create.baseUrl %>" autocomplete="off">
    </label>
    <div class="form-row form-row-2">
      <label><%= t("create.clientId") %>
        <input name="clientId" required value="<%= create.clientId %>" autocomplete="off">
      </label>
      <label><%= t("create.clientSecret") %>
        <input name="clientSecret" type="password" value="" placeholder="<%= create.hasSecret ? "••••••••  (" + t("create.keepSecret") + ")" : "" %>" autocomplete="new-password">
      </label>
    </div>
    <% if (useOrgSelect) { %>
    <div class="form-row form-row-2">
      <label><%= t("create.organizationId") %>
        <select name="organizationId" required data-create-org>
          <% if (orgOptions.length > 1) { %>
          <option value=""><%= t("create.pickOrganization") %></option>
          <% } %>
          <% orgOptions.forEach(function (org) { %>
          <option value="<%= org.id %>"<%= org.id === selectedOrg ? " selected" : "" %>><%= org.name %></option>
          <% }) %>
          <% if (selectedOrg && !orgInList) { %>
          <option value="<%= selectedOrg %>" selected><%= selectedOrg %></option>
          <% } %>
        </select>
      </label>
      <label><%= t("create.unitId") %>
        <select name="unitId" required data-create-unit data-empty-label="<%= t("create.pickUnit") %>"<%= selectedOrg ? "" : " disabled" %>>
          <option value=""><%= t("create.pickUnit") %></option>
          <% unitOptions.forEach(function (unit) { %>
          <option value="<%= unit.id %>"<%= unit.id === selectedUnit ? " selected" : "" %>><%= unit.name %></option>
          <% }) %>
          <% if (selectedUnit && !unitInList) { %>
          <option value="<%= selectedUnit %>" selected><%= selectedUnit %></option>
          <% } %>
        </select>
        <span class="hint" data-create-unit-hint hidden><%= t("common.loading") %></span>
      </label>
    </div>
    <% } else { %>
    <div class="form-row form-row-2">
      <label><%= t("create.organizationId") %>
        <input name="organizationId" value="<%= create.organizationId %>" autocomplete="off">
        <span class="hint"><%= catalog.needsCredentials ? t("create.catalogNeedsCredentials") : t("create.catalogEmpty") %></span>
      </label>
      <label><%= t("create.unitId") %>
        <input name="unitId" required value="<%= create.unitId %>" autocomplete="off">
      </label>
    </div>
    <% } %>
    <label><%= t("create.contentSourceId") %>
      <input name="contentSourceId" required value="<%= create.contentSourceId %>" autocomplete="off">
    </label>
  </section>

  <section class="settings-panel" role="tabpanel" id="create-panel-webhooks" aria-labelledby="create-tab-webhooks" data-form-panel="webhooks"<% if (activeTab !== "webhooks") { %> hidden<% } %>>
    <label><%= t("create.publicUrl") %>
      <input name="publicBaseUrl" class="settings-url" value="<%= create.publicBaseUrl %>" placeholder="https://zaakhub.example.nl" autocomplete="off">
      <span class="hint"><%= t("create.webhookHint") %></span>
    </label>
    <label><%= t("create.authDomain") %>
      <input name="authDomain" value="<%= create.authDomain %>" placeholder="auth.example.com" autocomplete="off">
      <span class="hint"><%= t("create.authDomainHint") %></span>
    </label>
    <div class="settings-note">
      <% if (webhookExample) { %>
      <p class="hint"><%= t("create.webhookExample", { url: webhookExample }) %></p>
      <% } %>
      <span class="field-caption"><%= t("create.lastWebhook") %></span>
      <% if (create.lastWebhookAt) { %>
      <p class="hint"><%= formatDateTime(create.lastWebhookAt) %></p>
      <p class="hint"><%= t("create.webhookStatus." + (create.lastWebhookStatus || "ok")) %><% if (create.lastWebhookDetail) { %> · <%= create.lastWebhookDetail %><% } %></p>
      <% if (create.lastWebhookPath) { %><p class="hint mono"><%= create.lastWebhookPath %></p><% } %>
      <% } else { %>
      <p class="hint"><%= t("create.lastWebhookNone") %></p>
      <% } %>
      <% if (create.lastSyncAt) { %>
      <span class="field-caption"><%= t("create.lastSync") %></span>
      <p class="hint"><%= formatDateTime(create.lastSyncAt) %></p>
      <% } %>
    </div>
  </section>

  </div>
  <footer class="settings-sheet-foot">
    <button class="btn" type="submit"><%= t("create.save") %></button>
    <button class="ghost" type="submit" form="create-test"><%= t("integrations.test") %></button>
    <a class="ghost" href="/templates"><%= t("create.templates", { n: recipeCount }) %></a>
  </footer>
</form>
<form id="create-test" method="post" action="/instellingen/create/test" hidden></form>

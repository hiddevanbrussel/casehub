<%
  const recentEmployees = typeof werknemers !== "undefined" ? werknemers : [];
  const kpis = insights || {};
  const lead = kpis.leadTime || { series: [], ticks: [], line: "", area: "", width: 520, height: 176 };
  function deltaClass(n) {
    if (n == null) return "";
    return n < 0 ? "is-down" : "is-up";
  }
  function deltaLabel(n) {
    if (n == null) return "";
    const sign = n > 0 ? "+" : "";
    return t("dash.vsPrev", { n: sign + n });
  }
  function whenLabel(iso) {
    const bucket = dayBucket(iso);
    if (bucket === "today") return t("dash.todayAt", { time: formatTime(iso) });
    if (bucket === "yesterday") return t("dash.yesterdayAt", { time: formatTime(iso) });
    return formatDateTimeShort(iso);
  }
%>
<div class="dash">
  <div class="page-head dash-head">
    <div>
      <h1><%= firstName ? t("dash.welcome", { name: firstName }) : t("dash.title") %></h1>
      <p class="lede"><%= isHr && !isCases ? t("dash.welcomeHrLede") : t("dash.welcomeLede") %></p>
    </div>
    <div class="actions">
      <% if (isCases) { %>
      <a class="btn dash-cta" href="/zaken?nieuw=1">
        <%- icon("plus") %>
        <%= t("dash.newCase") %>
      </a>
      <% } else if (canWriteEmployees) { %>
      <a class="btn dash-cta" href="/werknemers?nieuw=1"><%= t("nav.newEmployee") %></a>
      <% } %>
    </div>
  </div>

  <% if (isCases) { %>
  <section class="kpis" aria-label="<%= t('dash.title') %>">
    <article class="kpi kpi-hero">
      <div class="kpi-copy">
        <span><%= t("dash.openCases") %></span>
        <strong><%= counts.open %></strong>
        <% if (kpis.openDelta != null) { %><small class="kpi-delta <%= deltaClass(kpis.openDelta) %>"><%= deltaLabel(kpis.openDelta) %></small><% } %>
      </div>
      <span class="kpi-ico" aria-hidden="true"><%- icon("folder") %></span>
    </article>
    <article class="kpi">
      <div class="kpi-copy">
        <span><%= t("dash.closedMonth") %></span>
        <strong><%= kpis.closedThis || 0 %></strong>
        <% if (kpis.closedDelta != null) { %><small class="kpi-delta <%= deltaClass(kpis.closedDelta) %>"><%= deltaLabel(kpis.closedDelta) %></small><% } %>
      </div>
      <span class="kpi-ico" aria-hidden="true"><%- icon("circle-check") %></span>
    </article>
    <article class="kpi">
      <div class="kpi-copy">
        <span><%= t("dash.newMonth") %></span>
        <strong><%= kpis.newThis || 0 %></strong>
        <% if (kpis.newDelta != null) { %><small class="kpi-delta <%= deltaClass(kpis.newDelta) %>"><%= deltaLabel(kpis.newDelta) %></small><% } %>
      </div>
      <span class="kpi-ico" aria-hidden="true"><%- icon("plus") %></span>
    </article>
    <article class="kpi">
      <div class="kpi-copy">
        <span><%= t("dash.overdue") %></span>
        <strong><%= kpis.overdue || 0 %></strong>
      </div>
      <span class="kpi-ico" aria-hidden="true"><%- icon("clock-alert") %></span>
    </article>
  </section>
  <% } else { %>
  <section class="kpis kpis-hr" aria-label="<%= t('dash.title') %>">
    <article class="kpi kpi-hero">
      <div class="kpi-copy">
        <span><%= t("nav.employees") %></span>
        <strong><%= counts.werknemers %></strong>
      </div>
      <span class="kpi-ico" aria-hidden="true"><%- icon("users") %></span>
    </article>
    <article class="kpi">
      <div class="kpi-copy">
        <span><%= t("dash.recentDocs") %></span>
        <strong><%= documenten.length %></strong>
      </div>
      <span class="kpi-ico" aria-hidden="true"><%- icon("file-text") %></span>
    </article>
  </section>
  <% } %>

  <div class="grid-2 dash-mid<%= isCases ? "" : " is-single" %>">
    <% if (isCases) { %>
    <section class="panel dash-chart">
      <header>
        <h2><%= t("dash.leadTime") %></h2>
        <span class="muted"><%= t("dash.last6m") %></span>
      </header>
      <% if (!lead.line) { %><p class="muted"><%= t("dash.noLeadTime") %></p><% } %>
      <div class="lead-chart<%= lead.line ? "" : " is-empty" %>">
        <% if (lead.current != null) { %>
        <div class="lead-now" style="left: <%= ((lead.series.find(function (p) { return p.last; }) || {}).x / lead.width * 100).toFixed(1) %>%">
          <strong><%= t("dash.daysLong", { n: lead.current }) %></strong>
          <% if (lead.delta != null) { %><small class="kpi-delta <%= deltaClass(lead.delta) %>"><%= deltaLabel(lead.delta) %></small><% } %>
        </div>
        <% } %>
        <svg viewBox="0 0 <%= lead.width %> <%= lead.height %>" role="img" aria-label="<%= t('dash.leadTime') %>">
          <% (lead.ticks || []).forEach(function (tick) { %>
            <line class="lead-gridline" x1="<%= lead.padLeft || 36 %>" x2="<%= lead.width - (lead.padRight || 14) %>" y1="<%= tick.y %>" y2="<%= tick.y %>"></line>
            <text class="lead-tick" x="0" y="<%= tick.y + 4 %>"><%= tick.days %> d</text>
          <% }) %>
          <% if (lead.area) { %><path class="lead-area" d="<%= lead.area %>"></path><% } %>
          <% if (lead.line) { %><path class="lead-line" d="<%= lead.line %>"></path><% } %>
          <% lead.series.forEach(function (p) { if (p.last) { %>
            <circle class="lead-dot" cx="<%= p.x.toFixed(1) %>" cy="<%= p.y.toFixed(1) %>" r="5"></circle>
          <% } }) %>
        </svg>
        <ol class="lead-months">
          <% lead.series.forEach(function (p) { %>
            <li><%= p.label %></li>
          <% }) %>
        </ol>
      </div>
    </section>
    <% } %>

    <section class="panel dash-feed">
      <header>
        <h2><%= t("dash.activity") %></h2>
        <span class="muted"><%= t("dash.thisWeek") %></span>
      </header>
      <% if (!activity.length) { %>
        <p class="muted"><%= t("dash.noActivity") %></p>
      <% } else { %>
        <ol class="dash-activity">
          <% activity.forEach(function (ev) { %>
          <li>
            <span class="dash-activity-ico ico-<%= ev.entity || 'zaak' %>" aria-hidden="true">
              <% if (ev.entity === "document") { %>
              <%- icon("file-text") %>
              <% } else if (ev.entity === "werknemer") { %>
              <%- icon("user") %>
              <% } else { %>
              <%- icon("bookmark") %>
              <% } %>
            </span>
            <div>
              <p><%= ev.detail || t("entity." + ev.entity) %></p>
              <small><%= whenLabel(ev.at) %></small>
            </div>
          </li>
          <% }) %>
        </ol>
      <% } %>
    </section>
  </div>

  <% if (isCases) { %>
  <section class="panel dash-recent">
    <header>
      <h2><%= t("dash.recentCases") %></h2>
      <a href="/zaken"><%= t("dash.viewAllShort") %></a>
    </header>
    <% if (!zaken.length) { %>
      <p class="muted"><%= t("dash.noCases") %></p>
    <% } else { %>
      <table class="dash-table">
        <thead>
          <tr>
            <th><%= t("cases.caseId") %></th>
            <th><%= t("dash.subject") %></th>
            <th><%= t("cases.type") %></th>
            <th><%= t("cases.status") %></th>
            <th><%= t("dash.lastUpdated") %></th>
          </tr>
        </thead>
        <tbody>
          <% zaken.forEach(function (z) { %>
          <tr>
            <td><a href="/zaken/<%= z.id %>"><%= z.zaaknummer %></a></td>
            <td><a href="/zaken/<%= z.id %>"><%= z.titel %></a></td>
            <td class="muted"><%= z.zaaktype || "—" %></td>
            <td><span class="dash-status dash-status-<%= z.status %>"><%= t("status." + z.status) %></span></td>
            <td class="muted"><%= whenLabel(z.updatedAt) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
  <% } %>

  <% if (isHr) { %>
  <section class="panel dash-recent">
    <header>
      <h2><%= t("dash.recentEmployees") %></h2>
      <a href="/werknemers"><%= t("dash.viewEmployees") %></a>
    </header>
    <% if (!recentEmployees.length) { %>
      <p class="muted"><%= t("dash.noEmployees") %></p>
    <% } else { %>
      <table class="dash-table">
        <thead>
          <tr>
            <th><%= t("employees.name") %></th>
            <th><%= t("hr.staffNo") %></th>
            <th><%= t("hr.job") %></th>
          </tr>
        </thead>
        <tbody>
          <% recentEmployees.forEach(function (w) { %>
          <tr>
            <td><a href="/werknemers/<%= w.id %>"><%= w.naam %></a></td>
            <td><%= w.personeelsnummer || "—" %></td>
            <td class="muted"><%= w.functiebenaming || t("role." + w.rol) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
  <% } %>
</div>

<%
  function listQs(overrides) {
    const src = Object.assign({
      q: q,
      group: group,
      focus: typeof focus !== "undefined" ? focus : "",
    }, overrides || {});
    const params = [];
    Object.keys(src).forEach(function (key) {
      const value = src[key];
      if (!value) return;
      params.push(encodeURIComponent(key) + "=" + encodeURIComponent(value));
    });
    return params.length ? "?" + params.join("&") : "";
  }
  function addressLine(w) {
    const street = [w.straat, w.huisnummer].filter(Boolean).join(" ");
    return [street, [w.postcode, w.plaats].filter(Boolean).join(" ")].filter(Boolean).join(", ");
  }
  function salutationLabel(value) {
    if (value === "heer") return t("hr.heer");
    if (value === "mevrouw") return t("hr.mevrouw");
    return "";
  }
  const peekEmp = typeof peek !== "undefined" ? peek : null;
  const focusId = typeof focus !== "undefined" ? focus : "";
  const composing = Boolean(typeof compose !== "undefined" && compose);
  const startEditing = Boolean(typeof forceEdit !== "undefined" && forceEdit);
  const peekCaseRows = typeof peekCases !== "undefined" ? peekCases : [];
  const canEditPeek = Boolean(canWrite && peekEmp);
  const canDelete = Boolean(canWrite);
  const canDeletePeek = Boolean(canDelete && peekEmp && typeof user !== "undefined" && user && peekEmp.id !== user.id);
  const pending = Boolean(typeof lazyPending !== "undefined" && lazyPending);
  const formError = typeof error !== "undefined" ? error : "";
  const editing = composing || startEditing;
%>
<section class="list-work" data-list-lazy<% if (pending) { %> data-list-pending<% } %>>
  <div class="list-pane" id="staff-queue">
    <div class="mail-folder">
      <h1><%= t("nav.employees") %></h1>
      <% if (canWrite) { %>
      <a class="btn dash-cta mail-new" href="<%= listQs({ nieuw: 1, focus: '' }) %>">
        <%- icon("plus") %>
        <%= t("employees.new") %>
      </a>
      <% } %>
    </div>
    <form class="list-toolbar" method="get" action="/werknemers">
      <label class="list-search">
        <%- icon("search") %>
        <input type="search" name="q" value="<%= q %>" placeholder="<%= t('employees.search') %>">
      </label>
      <div class="list-filters">
        <select name="group" class="list-filter" data-auto-submit>
          <option value=""><%= t("employees.allRoles") %></option>
          <% groups.forEach(function (g) { %>
            <option value="<%= g.id %>" <%= group === g.id ? "selected" : "" %>><%= t("role." + g.id) %></option>
          <% }) %>
        </select>
      </div>
      <% if (focusId) { %><input type="hidden" name="focus" value="<%= focusId %>"><% } %>
    </form>

    <div class="list-fill" data-list-slot="queue">
    <% if (pending) { %>
      <%- include("../partials/list-skeleton", { simple: true, checks: canDelete, count: 8 }) %>
      <noscript>
        <p class="empty list-empty"><a href="<%= listQs({ full: 1 }) %>"><%= t("common.showList") %></a></p>
      </noscript>
    <% } else if (!werknemers.length && !composing) { %>
      <div class="empty list-empty"><%= t("employees.noFound") %></div>
    <% } else { %>
    <% if (canDelete) { %><form class="list-bulk-form" method="post" action="/werknemers/bulk" data-confirm-delete="<%= t('employees.confirmDeleteMany') %>"><% } %>
    <% if (canDelete) { %>
      <% if (q) { %><input type="hidden" name="filterQ" value="<%= q %>"><% } %>
      <% if (group) { %><input type="hidden" name="filterGroup" value="<%= group %>"><% } %>
    <% } %>
    <div class="queue<%= canDelete ? " has-checks" : "" %>" data-queue>
      <% if (canDelete) { %>
      <div class="queue-head">
        <label class="list-check">
          <input type="checkbox" data-check-all aria-label="<%= t('caseTypes.selectAll') %>">
        </label>
      </div>
      <% } %>
      <% if (composing) { %>
      <div class="queue-row is-focused is-draft is-simple">
        <% if (canDelete) { %><span class="list-check" aria-hidden="true"></span><% } %>
        <div class="queue-hit">
          <span class="queue-top">
            <span class="queue-from"><%= t("hr.staffNo") %></span>
            <span class="queue-when"></span>
          </span>
          <strong class="queue-title" data-draft-title data-empty="<%= t('employees.new') %>"><%= t("employees.new") %></strong>
          <span class="queue-snippet"><%= t("cases.newDraft") %></span>
        </div>
      </div>
      <% } %>
      <% werknemers.forEach(function (w) { %>
      <div class="queue-row is-simple <%= w.id === focusId ? 'is-focused' : '' %>" data-open="/werknemers/<%= w.id %>">
        <% if (canDelete) { %>
        <label class="list-check">
          <input type="checkbox" name="ids" value="<%= w.id %>" data-check-row aria-label="<%= w.naam %>" <%= typeof user !== "undefined" && user && w.id === user.id ? "disabled" : "" %>>
        </label>
        <% } %>
        <a class="queue-hit" href="<%= listQs({ focus: w.id }) %>" <%= w.id === focusId ? 'aria-current="true"' : '' %>>
          <span class="queue-top">
            <span class="queue-from"><%= isHr ? (w.personeelsnummer || t("hr.staffNo")) : t("role." + w.rol) %></span>
            <span class="queue-when"><%= w.updatedAt ? formatDate(w.updatedAt) : "" %></span>
          </span>
          <strong class="queue-title" title="<%= w.naam %>"><%= w.naam %></strong>
          <span class="queue-snippet"><%= isHr ? ((w.functiebenaming || w.vestiging || w.email || "") + (w.rol ? " · " + t("role." + w.rol) : "")) : ((w.email || "") + (w.afdeling ? " · " + w.afdeling : "")) %></span>
        </a>
      </div>
      <% }) %>
    </div>
    <% if (canDelete) { %>
      <%- include("../partials/list-bulk-delete") %>
    </form>
    <% } %>
    <% } %>
    </div>
  </div>

  <div
    class="list-split"
    role="separator"
    aria-orientation="vertical"
    aria-controls="staff-queue"
    aria-valuemin="220"
    aria-valuemax="560"
    aria-valuenow="280"
    aria-label="<%= t('cases.resizeList') %>"
    title="<%= t('cases.resizeList') %>"
    tabindex="0"
    data-split
  ><span class="visually-hidden"><%= t("cases.resizeList") %></span></div>

  <div class="list-peek-slot" data-list-slot="peek">
  <% if (pending) { %>
    <%- include("../partials/peek-skeleton") %>
  <% } else { %>
  <aside class="list-peek<%= editing ? ' is-editing' : '' %>" data-peek<% if (composing) { %> data-peek-compose<% } %> aria-live="polite">
    <% if (!peekEmp) { %>
      <div class="list-peek-empty">
        <p><%= t("employees.peekEmpty") %></p>
      </div>
    <% } else { %>
      <% const peekRecipes = typeof recipes !== "undefined" ? recipes : []; %>
      <% const peekStufOn = Boolean(typeof stufReady !== "undefined" && stufReady);
      const peekCreateOn = Boolean(typeof createEnabled !== "undefined" && createEnabled);
      const peekCanGenerate = Boolean(isHr && typeof createReady !== "undefined" && createReady && (peekRecipes.length || peekStufOn)); %>
      <% const peekGenerateHint = (typeof createReady !== "undefined" && createReady)
        ? (peekRecipes.length || peekStufOn ? t("hr.docEmptyHint") : t("cases.noTemplates"))
        : t("cases.generateNeedsIntegration"); %>
      <% if (canEditPeek && !composing) { %>
      <div class="peek-bar peek-view">
        <div class="peek-actions">
          <button type="button" class="peek-edit-toggle" data-peek-edit>
            <%- icon("pencil") %>
            <%= t("common.edit") %>
          </button>
          <% if (isHr) { %>
          <% if (peekCreateOn && peekRecipes.length) { %>
          <button type="button" class="btn peek-create-doc" data-generate-open="generate" <%= peekCanGenerate ? "" : "disabled" %><% if (!peekCanGenerate) { %> title="<%= peekGenerateHint %>"<% } %>>
            <%- icon("file-plus") %>
            <%= t("cases.createDoc") %>
          </button>
          <% } %>
          <% if (peekStufOn) { %>
          <button type="button" class="<%= peekCreateOn && peekRecipes.length ? "ghost peek-create-stuf" : "btn peek-create-doc" %>" data-generate-open="interactive" <%= peekCanGenerate ? "" : "disabled" %><% if (!peekCanGenerate) { %> title="<%= peekGenerateHint %>"<% } %>>
            <%- icon("file-output") %>
            <%= t("cases.generateInteractive") %>
          </button>
          <% } else if (!(peekCreateOn && peekRecipes.length)) { %>
          <button type="button" class="btn peek-create-doc" data-generate-open="generate" disabled title="<%= peekGenerateHint %>">
            <%- icon("file-plus") %>
            <%= t("cases.createDoc") %>
          </button>
          <% } %>
          <% } %>
          <% if (canDeletePeek) { %>
          <details class="menu-dots">
            <summary class="icon-more" aria-label="<%= t('cases.more') %>"><%- icon("ellipsis") %></summary>
            <div class="menu-dots-list">
              <form method="post" action="/werknemers/<%= peekEmp.id %>/verwijderen" data-confirm="<%= t('employees.confirmDelete') %>">
                <input type="hidden" name="from" value="list">
                <% if (q) { %><input type="hidden" name="filterQ" value="<%= q %>"><% } %>
                <% if (group) { %><input type="hidden" name="filterGroup" value="<%= group %>"><% } %>
                <button class="danger-text" type="submit"><%= t("common.delete") %></button>
              </form>
            </div>
          </details>
          <% } %>
        </div>
      </div>
      <% } %>
      <% if (canEditPeek || composing) { %>
      <div class="peek-bar peek-edit">
        <% if (composing) { %>
        <a href="/werknemers<%= listQs({ focus: '' }) %>" data-peek-cancel><%= t("common.cancel") %></a>
        <% } else { %>
        <button type="button" data-peek-cancel><%= t("common.cancel") %></button>
        <% } %>
        <button class="btn" type="submit" form="peek-inline"><%= t("common.save") %></button>
      </div>
      <% } %>
      <form id="peek-inline" class="peek-inline" method="post" action="<%= composing ? '/werknemers' : '/werknemers/' + peekEmp.id %>">
        <input type="hidden" name="from" value="list">
        <% if (q) { %><input type="hidden" name="filterQ" value="<%= q %>"><% } %>
        <% if (group) { %><input type="hidden" name="filterGroup" value="<%= group %>"><% } %>
        <% if (!composing) { %><input type="hidden" name="filterFocus" value="<%= peekEmp.id %>"><% } %>
        <% if (formError) { %><p class="alert"><%= formError %></p><% } %>
        <p class="peek-id"><%= composing ? t("cases.caseIdSoon") : (peekEmp.personeelsnummer || t("hr.staffNo")) %></p>
        <h2 class="peek-subject peek-view"><%= peekEmp.naam || t("employees.new") %></h2>
        <div class="peek-fields peek-edit">
          <% if (isHr) { %>
          <label><%= t("hr.salutation") %>
            <select name="aanhef">
              <option value="">—</option>
              <option value="heer" <%= peekEmp.aanhef === "heer" ? "selected" : "" %>><%= t("hr.heer") %></option>
              <option value="mevrouw" <%= peekEmp.aanhef === "mevrouw" ? "selected" : "" %>><%= t("hr.mevrouw") %></option>
            </select>
          </label>
          <label><%= t("hr.staffNo") %>
            <input class="is-readonly" value="<%= composing ? t('cases.caseIdSoon') : (peekEmp.personeelsnummer || "") %>" readonly>
          </label>
          <% } %>
          <label><%= t("employees.firstName") %>
            <input id="peek-title" name="voornaam" required value="<%= peekEmp.voornaam || "" %>" data-draft-part autocomplete="off">
          </label>
          <label><%= t("employees.lastName") %>
            <input name="achternaam" required value="<%= peekEmp.achternaam || "" %>" data-draft-part>
          </label>
          <% if (isHr) { %>
          <label><%= t("hr.dob") %>
            <input type="date" name="geboortedatum" value="<%= peekEmp.geboortedatum || "" %>">
          </label>
          <label><%= t("hr.startDate") %>
            <input type="date" name="datumIndiensttreding" value="<%= peekEmp.datumIndiensttreding || "" %>">
          </label>
          <label><%= t("hr.street") %>
            <input name="straat" value="<%= peekEmp.straat || "" %>">
          </label>
          <label><%= t("hr.houseNo") %>
            <input name="huisnummer" value="<%= peekEmp.huisnummer || "" %>">
          </label>
          <label><%= t("hr.postcode") %>
            <input name="postcode" value="<%= peekEmp.postcode || "" %>">
          </label>
          <label><%= t("hr.city") %>
            <input name="plaats" value="<%= peekEmp.plaats || "" %>">
          </label>
          <label><%= t("hr.job") %>
            <input name="functiebenaming" value="<%= peekEmp.functiebenaming || "" %>">
          </label>
          <label><%= t("hr.location") %>
            <input name="vestiging" value="<%= peekEmp.vestiging || peekEmp.afdeling || "" %>">
          </label>
          <label><%= t("hr.scale") %>
            <input name="inschaling" value="<%= peekEmp.inschaling || "" %>">
          </label>
          <label><%= t("hr.salary") %>
            <input name="salaris" inputmode="decimal" value="<%= peekEmp.salaris || "" %>">
          </label>
          <label class="check-label peek-span">
            <input type="hidden" name="leaseauto" value="0">
            <input type="checkbox" name="leaseauto" value="1" <%= peekEmp.leaseauto ? "checked" : "" %>>
            <%= t("hr.companyCar") %>
          </label>
          <% } %>
          <label><%= t("employees.email") %>
            <input type="email" name="email" <%= isHr ? "" : "required" %> value="<%= peekEmp.email || "" %>">
          </label>
          <% if (typeof isGlobalAdmin !== "undefined" && isGlobalAdmin && typeof workspaces !== "undefined" && workspaces.length) { %>
          <label class="peek-span"><%= t("employees.workspace") %>
            <select name="workspace">
              <% workspaces.forEach(function (item) { %>
              <option value="<%= item.slug %>" <%= workspace && workspace.slug === item.slug ? "selected" : "" %>><%= item.name %></option>
              <% }) %>
            </select>
            <span class="hint"><%= t("employees.workspaceHint") %></span>
          </label>
          <% } %>
          <label><%= t("employees.role") %>
            <select name="rol">
              <% groups.forEach(function (r) { %>
                <option value="<%= r.id %>" <%= (peekEmp.rol || "medewerker") === r.id ? "selected" : "" %>><%= t("role." + r.id) %></option>
              <% }) %>
            </select>
          </label>
          <% if (!isHr) { %>
          <label class="peek-span"><%= t("employees.department") %>
            <input name="afdeling" value="<%= peekEmp.afdeling || "" %>">
          </label>
          <% } %>
          <label class="peek-span"><%= t("employees.password") %>
            <input type="password" name="wachtwoord" <%= (!isHr && composing) ? "required" : "" %> placeholder="<%= composing ? (isHr ? t('hr.passwordHint') : "") : t('employees.keepPassword') %>" autocomplete="new-password">
          </label>
        </div>
        <dl class="peek-props peek-view">
          <div class="peek-props-row">
            <div>
              <dt><%= t("employees.email") %></dt>
              <dd class="<%= peekEmp.email ? '' : 'is-empty' %>"><%= peekEmp.email || "—" %></dd>
            </div>
            <div>
              <dt><%= t("employees.role") %></dt>
              <dd><%= peekEmp.rol ? t("role." + peekEmp.rol) : "—" %></dd>
            </div>
            <div>
              <% if (isHr) { %>
              <dt><%= t("hr.job") %></dt>
              <dd class="<%= peekEmp.functiebenaming ? '' : 'is-empty' %>"><%= peekEmp.functiebenaming || "—" %></dd>
              <% } else { %>
              <dt><%= t("employees.department") %></dt>
              <dd class="<%= peekEmp.afdeling ? '' : 'is-empty' %>"><%= peekEmp.afdeling || "—" %></dd>
              <% } %>
            </div>
          </div>
          <% if (isHr) { %>
          <div class="peek-props-row">
            <div>
              <dt><%= t("hr.location") %></dt>
              <dd class="<%= peekEmp.vestiging ? '' : 'is-empty' %>"><%= peekEmp.vestiging || "—" %></dd>
            </div>
            <div>
              <dt><%= t("hr.startDate") %></dt>
              <dd class="<%= peekEmp.datumIndiensttreding ? '' : 'is-empty' %>"><%= peekEmp.datumIndiensttreding ? formatDateLong(peekEmp.datumIndiensttreding) : "—" %></dd>
            </div>
            <div>
              <dt><%= t("hr.companyCar") %></dt>
              <dd><%= peekEmp.leaseauto ? t("hr.yes") : t("hr.no") %></dd>
            </div>
          </div>
          <% } %>
        </dl>
        <% if (isHr) { %>
        <p class="peek-copy peek-view"><%= [salutationLabel(peekEmp.aanhef), addressLine(peekEmp)].filter(Boolean).join(" · ") || t("employees.noAddress") %></p>
        <% } %>
      </form>
      <% if (!composing && isHr) { %>
      <% const peekDocRows = documentRows(peekEmp, { basePath: "/werknemers/" + peekEmp.id }); %>
      <section class="peek-related peek-view">
        <h3><%= t("cases.tabDocuments") %><% if (peekDocRows.length) { %> (<%= peekDocRows.length %>)<% } %></h3>
        <%- include("../partials/doc-list", {
          docRows: peekDocRows,
          fromList: true,
          canDelete: canWrite,
          emptyTitle: t("hr.docEmpty"),
          emptyHint: peekCanGenerate ? t("hr.docEmptyHint") : peekGenerateHint,
        }) %>
      </section>
      <%- include("../partials/generate-doc", { action: "/werknemers/" + peekEmp.id + "/documenten", recipes: peekRecipes, canGenerate: peekCanGenerate, hideButtons: true, fromList: true }) %>
      <% } %>
      <% if (!composing && isCases) { %>
      <section class="peek-related peek-view">
        <h3><%= t("employees.assignedCases") %><% if (peekCaseRows.length) { %> (<%= peekCaseRows.length %>)<% } %></h3>
        <%- include("../partials/case-list", {
          caseRows: peekCaseRows,
          compact: true,
          limit: 8,
          viewAllHref: peekEmp.id ? "/werknemers/" + peekEmp.id + "?tab=cases" : "",
          emptyTitle: t("employees.noCases"),
        }) %>
      </section>
      <% } %>
    <% } %>
  </aside>
  <% } %>
  </div>
</section>

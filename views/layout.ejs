<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= meta.orgName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/app.css">
</head>
<body>
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M9 3h6l1 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3zm3 5a4 4 0 1 0 4 4 4 4 0 0 0-4-4z"/></svg>
      </span>
      <strong><%= meta.orgName %></strong>
    </a>

    <label class="side-search">
      <svg viewBox="0 0 24 24"><path d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zm8.3 12.9 3.2 3.2-1.4 1.4-3.2-3.2a8.5 8.5 0 1 1 1.4-1.4z"/></svg>
      <input type="search" placeholder="<%= t('nav.search') %>" data-palette-open readonly>
    </label>

    <nav>
      <p class="nav-label"><%= t('nav.home') %></p>
      <a class="<%= path === '/' ? 'is-active' : '' %>" href="/">
        <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></svg>
        <%= t('nav.dashboard') %>
      </a>
      <a class="<%= navActive('/zaken') %>" href="/zaken">
        <svg viewBox="0 0 24 24"><path d="M7 4h10a2 2 0 0 1 2 2v14l-7-3-7 3V6a2 2 0 0 1 2-2z"/></svg>
        <%= t('nav.cases') %>
      </a>

      <p class="nav-label"><%= t('nav.naw') %></p>
      <a class="<%= navActive('/personen') %>" href="/personen">
        <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v2h16v-2c0-2.8-3.6-5-8-5z"/></svg>
        <%= t('nav.persons') %>
      </a>
      <a class="<%= navActive('/bedrijven') %>" href="/bedrijven">
        <svg viewBox="0 0 24 24"><path d="M3 21V8l6-4 6 4v13H3zm8-4h2v2h-2zm6 4V10h4v11h-4z"/></svg>
        <%= t('nav.companies') %>
      </a>

      <% if (user && user.rol === 'admin') { %>
      <p class="nav-label"><%= t('nav.admin') %></p>
      <a class="<%= navActive('/werknemers') %>" href="/werknemers">
        <svg viewBox="0 0 24 24"><path d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zM8 12a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm8 2c-2.7 0-5.2 1.3-6 3.2A7.5 7.5 0 0 1 22 19c0-2.8-2.7-5-6-5zM8 14c-3.3 0-6 2-6 4.5V21h7.2A6.7 6.7 0 0 1 8 14z"/></svg>
        <%= t('nav.employees') %>
      </a>
      <a class="<%= navActive('/audit') %>" href="/audit">
        <svg viewBox="0 0 24 24"><path d="M8 5h11v2H8zm0 6h11v2H8zm0 6h11v2H8zM5 5h1v2H5zm0 6h1v2H5zm0 6h1v2H5z"/></svg>
        <%= t('nav.audit') %>
      </a>
      <a class="<%= navActive('/instellingen') %>" href="/instellingen">
        <svg viewBox="0 0 24 24"><path d="M10 3h4l.5 2.2a7 7 0 0 1 1.6.9L18.5 5l2.5 4-1.8 1.4a7 7 0 0 1 0 1.8L21 13.5 18.5 17.5l-2.4-1.1a7 7 0 0 1-1.6.9L14 21h-4l-.5-2.2a7 7 0 0 1-1.6-.9L5.5 19 3 15l1.8-1.4a7 7 0 0 1 0-1.8L3 10.5 5.5 6.5l2.4 1.1a7 7 0 0 1 1.6-.9zm2 6.5A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5z"/></svg>
        <%= t('nav.settings') %>
      </a>
      <% } %>
    </nav>

    <div class="sidebar-foot">
      <a class="btn btn-block" href="/zaken/nieuw"><%= t('nav.newCase') %></a>
      <% if (user) { %>
      <% const initials = String(user.naam || "?").split(/\s+/).filter(Boolean).map(function (part) { return part[0]; }).slice(0, 2).join("").toUpperCase(); %>
      <div class="who-card">
        <span class="who-avatar" aria-hidden="true"><%= initials %></span>
        <div class="who-meta">
          <strong><%= user.naam %></strong>
          <small><%= t('role.' + user.rol) %></small>
        </div>
        <div class="who-actions">
          <%- include("partials/lang-switcher") %>
          <form method="post" action="/logout">
            <button class="who-out" type="submit" title="<%= t('nav.signOut') %>" aria-label="<%= t('nav.signOut') %>">
              <svg viewBox="0 0 24 24"><path d="M10 4h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-8v-2h8V6h-8zm-1.6 5.4L6 12l2.4 2.6-1.4 1.4L2.2 12l4.8-6 1.4 1.4zM8 11h8v2H8z"/></svg>
            </button>
          </form>
        </div>
      </div>
      <% } else { %>
      <%- include("partials/lang-switcher") %>
      <% } %>
    </div>
  </aside>

  <div class="shell">
    <main class="content">
      <%- body %>
    </main>
  </div>

  <dialog class="palette" id="palette">
    <input id="palette-q" placeholder="<%= t('search.placeholder') %>" autocomplete="off">
    <div id="palette-results"></div>
  </dialog>
  <dialog class="edit-modal" id="edit-modal"></dialog>
  <dialog class="pdf-modal" id="pdf-modal">
    <div class="modal-head">
      <h1 id="pdf-modal-title"><%= t('cases.tabDocuments') %></h1>
      <button type="button" class="icon-btn" data-modal-close aria-label="<%= t('common.close') %>">×</button>
    </div>
    <iframe id="pdf-modal-frame" title="PDF"></iframe>
    <footer class="modal-foot">
      <a class="ghost" id="pdf-modal-download" href="#" download><%= t('common.download') %></a>
      <button type="button" class="btn" data-modal-close><%= t('common.close') %></button>
    </footer>
  </dialog>

  <% if (toast) { %>
  <div class="toast" role="status"><%= toast %></div>
  <% } %>
  <script>window.I18N = <%- JSON.stringify({ nothing: t("search.nothing"), cases: t("nav.cases"), companies: t("nav.companies"), persons: t("nav.persons"), employees: t("nav.employees"), selected: t("templates.selected"), allAllowed: t("templates.allAllowed"), download: t("common.download") }) %>;</script>
  <script src="/public/js/app.js"></script>
</body>
</html>
